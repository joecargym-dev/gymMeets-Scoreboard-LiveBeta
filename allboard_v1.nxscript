<%
begin
  Output.Writeln('<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GymMeets Companion 4x1 Display v1.0</title>');
  Output.Writeln('<style>');
  Output.Writeln('*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000;font-family:Arial,Helvetica,sans-serif}:root{--bg:#070b10;--score:#ffff00;--name:#f5f8ff;--info:#00e5e5;--divider:#fff}');
  Output.Writeln('#board{position:relative;width:100vw;height:100vh;padding:1vw;background:var(--bg);display:grid;grid-template-rows:9.5% minmax(0,1fr) 12%;gap:.65vw;color:#fff}#board.header-title{grid-template-rows:7% minmax(0,1fr) 12%}#board.header-hidden{grid-template-rows:minmax(0,1fr) 12%}#board.no-sponsor{grid-template-rows:9.5% minmax(0,1fr)}#board.header-title.no-sponsor{grid-template-rows:7% minmax(0,1fr)}#board.header-hidden.no-sponsor{grid-template-rows:minmax(0,1fr)}');
  Output.Writeln('.header{display:grid;grid-template-columns:20% minmax(0,1fr) 20%;align-items:center;border:1px solid #26313c;border-radius:12px;overflow:hidden;min-height:0}.logo-slot{height:100%;display:flex;align-items:center;justify-content:center;background:#000;overflow:hidden}.logo-slot img{width:100%;height:100%;object-fit:contain}.meet-title{text-align:center;font-size:3vw;font-weight:900;text-transform:uppercase;white-space:nowrap;overflow:hidden;line-height:1;padding:0 .8vw;border-bottom:2px solid #00cfe8;transform-origin:center center}.header-title .logo-slot{display:none}.header-title .header{grid-template-columns:1fr}.header-hidden .header{display:none}');
  Output.Writeln('.grid{position:relative;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;min-height:0;overflow:hidden;border:1px solid #26313c;border-radius:12px}.grid:before,.grid:after{content:"";position:absolute;z-index:8;background:var(--divider);pointer-events:none}.grid:before{left:50%;top:1.5%;bottom:1.5%;width:2px;transform:translateX(-1px)}.grid:after{top:50%;left:1.5%;right:1.5%;height:2px;transform:translateY(-1px)}');
  Output.Writeln('.quad{position:relative;min-width:0;min-height:0;display:grid;grid-template-rows:minmax(0,58%) minmax(0,42%);padding:.45vw 1.15vw .7vw;overflow:hidden;container-type:size}.quad-top{display:grid;grid-template-columns:34% minmax(0,66%);align-items:center;gap:.35vw;min-height:0}.event-icon{width:100%;height:100%;object-fit:contain;transform:scale(1.42)}.score{font-size:9.8vw;line-height:.78;font-weight:900;text-align:right;letter-spacing:-.065em;color:var(--score);white-space:nowrap;transform:scaleX(1.04);transform-origin:right center;text-shadow:0 5px 18px rgba(255,215,0,.18)}');
  Output.Writeln('.quad-bottom{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:minmax(0,1fr) auto;gap:.15vw .6vw;align-items:end;min-height:0}.athlete{grid-column:1/-1;width:100%;min-width:0;font-size:6.4vw;font-size:min(6.4vw,28cqh);line-height:1.02;font-weight:900;letter-spacing:-.052em;color:var(--name);white-space:nowrap;overflow:visible;transform-origin:left center;padding:.04em 0 .1em}.gym{font-size:1.35vw;line-height:1;color:var(--info);font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{display:flex;justify-content:flex-end;gap:.35vw;white-space:nowrap}.pill{font-size:.82vw;line-height:1;font-weight:800;color:#ffff00;background:#000;border:1px solid #333;border-radius:999px;padding:.28vw .42vw}.paused{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.76);z-index:7;font-size:1.4vw;font-weight:900;color:#ffb84d;letter-spacing:.12em}.quad.is-paused .paused{display:flex}.quad.high{animation:highGlow 7s ease both}.quad.high:after{content:"EXCELLENT SCORE";position:absolute;top:.55vw;right:.65vw;z-index:9;background:#8b6400;color:#fff4bd;border:1px solid #ffd35b;border-radius:999px;padding:.28vw .55vw;font-size:.78vw;font-weight:900;letter-spacing:.08em}@keyframes highGlow{0%,100%{box-shadow:none}8%,88%{box-shadow:inset 0 0 0 5px #ffd700,inset 0 0 35px rgba(255,215,0,.45)}}');
  Output.Writeln('.sponsor{border:1px solid #bbb;border-radius:12px;overflow:hidden;background:#000;min-height:0}.sponsor img{display:block;width:100%;height:100%;object-fit:fill}.no-sponsor .sponsor{display:none}.version{position:fixed;right:.45vw;bottom:.2vw;z-index:30;color:#8f969f;font-size:.55vw;line-height:1;letter-spacing:.04em}.fullscreen{position:fixed;right:1vw;top:1vw;z-index:50;padding:.55vw .85vw;background:#05080c;color:#fff;border:1px solid #555;border-radius:8px;font-weight:700;cursor:pointer}.preview-mode .fullscreen{display:none!important}');
  Output.Writeln('.perfect-cinematic{position:fixed;inset:0;z-index:10000;background:#000;opacity:0;visibility:hidden;pointer-events:none;overflow:hidden}.perfect-cinematic.active{visibility:visible;animation:cinematicLayer 12.8s linear forwards}.perfect-cinematic canvas{position:absolute;inset:0;width:100%;height:100%}.perfect-logo-wrap{position:absolute;left:50%;top:50%;width:min(90vw,154vh);height:min(82vh,48vw);transform:translate(-50%,-50%) scale(.9);opacity:0;will-change:transform,opacity;display:flex;align-items:center;justify-content:center}.perfect-cinematic.active .perfect-logo-wrap{animation:perfectLogoJourney 12.8s cubic-bezier(.22,.8,.25,1) forwards}');
  Output.Writeln('.cinematic-ten{position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);font-family:Arial Black,Arial,sans-serif;font-size:min(30vw,50vh);line-height:.72;font-weight:1000;letter-spacing:-.075em;color:#fff;white-space:nowrap;text-shadow:0 0 3px rgba(115,255,174,1),0 0 9px rgba(115,255,174,.9),0 0 22px rgba(255,216,92,.98),0 0 46px rgba(255,188,35,.72),0 0 82px rgba(255,226,145,.38),0 8px 18px rgba(0,0,0,.85)}.cinematic-perfect-badge{position:absolute;left:50%;top:58%;transform:translate(-50%,-50%);min-width:47%;padding:.7vh 2.2vw;border:3px solid rgba(255,255,255,.9);border-radius:999px;background:linear-gradient(90deg,#11d5e7 0%,#aef4ef 42%,#ffe36d 68%,#ffb70f 100%);box-shadow:0 0 10px rgba(88,255,239,.95),0 0 26px rgba(255,190,35,.7);display:flex;align-items:center;justify-content:center;gap:1.4vw;color:#061019;white-space:nowrap}.cinematic-perfect-badge strong{font-family:Arial Black,Arial,sans-serif;font-size:min(3.9vw,6.2vh);line-height:1;font-weight:1000;letter-spacing:.035em}.cinematic-perfect-badge span{font-size:min(3.2vw,5.2vh);line-height:1}');
  Output.Writeln('.perfect-recognition{position:absolute;left:2vw;right:2vw;bottom:4vh;text-align:center;opacity:0;transform:translateY(30px);color:#fff;text-shadow:0 4px 18px #000}.perfect-cinematic.active .perfect-recognition{animation:perfectRecognition 12.8s ease forwards}.perfect-athlete{font-size:min(9.6vw,14.5vh);line-height:.92;font-weight:1000;letter-spacing:-.045em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.perfect-meta{margin-top:1.9vh;font-size:min(3.35vw,5.5vh);line-height:1.05;font-weight:900;letter-spacing:.055em;text-transform:uppercase;color:#ffd75c}@keyframes cinematicLayer{0%{opacity:0}3.9%,93.8%{opacity:1}100%{opacity:0}}@keyframes perfectLogoJourney{0%,23.4%{opacity:0;top:52%;transform:translate(-50%,-50%) scale(.9)}31.3%{opacity:1;top:52%;transform:translate(-50%,-50%) scale(1.01)}54.7%{opacity:1;top:52%;transform:translate(-50%,-50%) scale(.98)}62.5%{opacity:1;top:34%;transform:translate(-50%,-50%) scale(.95)}93.8%{opacity:1;top:34%;transform:translate(-50%,-50%) scale(.95)}100%{opacity:0;top:34%;transform:translate(-50%,-50%) scale(.95)}}@keyframes perfectRecognition{0%,57%{opacity:0;transform:translateY(30px)}63%,93.8%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-12px)}}');
  Output.Writeln('</style></head><body>');
  Output.Writeln('<button class="fullscreen" id="fullscreenButton" onclick="goFullScreen()">Full Screen</button><div id="board"><div class="header"><div class="logo-slot"><img id="hostLogo" src="images/gymmeets-companion-logo.png"></div><div class="meet-title" id="meetTitle">GYMMEETS COMPANION</div><div class="logo-slot"><img id="scoringLogo" src="images/scoring-logo.png"></div></div><div class="grid" id="eventGrid"></div><div class="sponsor"><img id="sponsorImage" src="images/sponsor-banner.png"></div></div><div class="version">GMC v1.0 · 4x1</div><div id="perfectCinematic" class="perfect-cinematic" aria-hidden="true"><canvas id="perfectParticles"></canvas><div class="perfect-logo-wrap" aria-label="Perfect 10 emblem"><div class="cinematic-ten">10.00</div><div class="cinematic-perfect-badge"><span>★</span><strong>PERFECT 10</strong><span>★</span></div></div><div class="perfect-recognition"><div id="perfectAthlete" class="perfect-athlete"></div><div id="perfectMeta" class="perfect-meta"></div></div></div>');
  Output.Writeln('<script>');
  Output.Writeln('const EVENTS=[{key:"vault",code:"VT",name:"VAULT",feed:"vaultdata_v1.nxscript",icon:"images/VT.png",command:"gymmeetsVaultCommandV1"},{key:"bars",code:"UB",name:"BARS",feed:"barsdata_v1.nxscript",icon:"images/UB.png",command:"gymmeetsBarsCommandV1"},{key:"beam",code:"BB",name:"BEAM",feed:"beamdata_v1.nxscript",icon:"images/BB.png",command:"gymmeetsBeamCommandV1"},{key:"floor",code:"FX",name:"FLOOR",feed:"floordata_v1.nxscript",icon:"images/FX.png",command:"gymmeetsFloorCommandV1"}];');
  Output.Writeln('const SETTINGS_KEY="gymmeetsAllSettingsV1",COMMAND_KEY="gymmeetsAllCommandV1",BRANDING_KEY="gymmeetsSharedBrandingV1",PURGE_KEY="gymmeetsAllPurgeStateV1";const defaults={displaySeconds:30,backgroundColor:"#070b10",scoreColor:"#ffff00",nameColor:"#f5f8ff",detailsColor:"#00e5e5",scoreFont:"Arial Black",nameFont:"Arial Black",detailsFont:"Arial",metadataFont:"Arial",metadataTextColor:"#ffff00",metadataBaseColor:"#000000",scoreSize:100,nameSize:100,iconSize:100,meetTitleColor:"#ffffff",meetTitleFont:"Arial Black",showNumber:true,showLevel:true,showDivision:true,showHostLogo:true,hostLogoData:"images/gymmeets-companion-logo.png",showScoringLogo:true,scoringLogoData:"images/scoring-logo.png",showSponsor:true,sponsorData:"images/sponsor-banner.png",titleSource:"proscore",headerMode:"full",customMeetName:"",enableHighScoreEffects:true,highScoreMinimum:9.7,enablePerfectTen:true};let settings={},settingsSignature="",perfectTimer=null,particleFrame=0,lastCommandAt=Date.now();');
  Output.Writeln('function parse(t){const p=t.split("|"),id=parseInt(p[0]||"0",10);if(!id)return null;return{id:id,num:p[1]||"",session:p[2]||"",level:p[3]||"",first:p[4]||"",last:p[5]||"",score:p[6]||"0.000",gym:p[9]||"",division:p[10]||"",meet:p[15]||""}}');
  Output.Writeln('function loadSettings(){let local={},brand={};try{local=JSON.parse(localStorage.getItem(SETTINGS_KEY)||"{}")}catch(e){}try{brand=JSON.parse(localStorage.getItem(BRANDING_KEY)||"{}")}catch(e){}return Object.assign({},defaults,local,brand)}function luminance(hex){hex=String(hex||"#000000").replace("#","");if(hex.length===3)hex=hex.split("").map(c=>c+c).join("");const n=parseInt(hex,16)||0,r=(n>>16)&255,g=(n>>8)&255,b=n&255;return(.299*r+.587*g+.114*b)/255}');
  Output.Writeln('function renderGrid(){eventGrid.innerHTML=EVENTS.map(e=>`<section class="quad" id="quad-${e.key}"><div class="quad-top"><img class="event-icon" src="${e.icon}"><div class="score" id="score-${e.key}">0.000</div></div><div class="quad-bottom"><div class="athlete" id="name-${e.key}">Waiting on Score</div><div class="gym" id="gym-${e.key}"></div><div class="meta"><span class="pill" id="level-${e.key}"></span><span class="pill" id="division-${e.key}"></span><span class="pill" id="number-${e.key}"></span></div></div><div class="paused">${e.name} PAUSED</div></section>`).join("")}');
  Output.Writeln('function applySettings(){const next=loadSettings(),signature=JSON.stringify(next);if(signature===settingsSignature)return;settingsSignature=signature;settings=next;board.style.setProperty("--bg",settings.backgroundColor);board.style.setProperty("--score",settings.scoreColor);board.style.setProperty("--name",settings.nameColor);board.style.setProperty("--info",settings.detailsColor);board.style.setProperty("--divider",luminance(settings.backgroundColor)>.58?"#000":"#fff");board.className=(settings.headerMode==="title"?"header-title ":settings.headerMode==="hidden"?"header-hidden ":"")+(settings.showSponsor?"":"no-sponsor");document.querySelectorAll(".score").forEach(x=>{x.style.fontFamily=settings.scoreFont;x.style.fontSize=(9.8*Number(settings.scoreSize||100)/100)+"vw"});document.querySelectorAll(".athlete").forEach(x=>{const n=Number(settings.nameSize||100)/100;x.style.fontFamily=settings.nameFont;x.style.fontSize="min("+(6.4*n)+"vw,"+(28*n)+"cqh)"});document.querySelectorAll(".gym").forEach(x=>x.style.fontFamily=settings.detailsFont);document.querySelectorAll(".pill").forEach(x=>{x.style.fontFamily=settings.metadataFont;x.style.color=settings.metadataTextColor;x.style.background=settings.metadataBaseColor});document.querySelectorAll(".event-icon").forEach(x=>x.style.transform="scale("+(1.42*Number(settings.iconSize||100)/100)+")");meetTitle.style.color=settings.meetTitleColor;meetTitle.style.fontFamily=settings.meetTitleFont;if(settings.titleSource==="custom"&&settings.customMeetName)meetTitle.textContent=settings.customMeetName;hostLogo.parentElement.style.display=settings.showHostLogo&&settings.headerMode==="full"?"flex":"none";scoringLogo.parentElement.style.display=settings.showScoringLogo&&settings.headerMode==="full"?"flex":"none";hostLogo.src=settings.hostLogoData||defaults.hostLogoData;scoringLogo.src=settings.scoringLogoData||defaults.scoringLogoData;sponsorImage.src=settings.sponsorData||defaults.sponsorData;settleFit()}');
  Output.Writeln('function formatScore(value){const numeric=Number(value||0);return Number.isFinite(numeric)&&Math.abs(numeric-10)<.0005?"10.00":numeric.toFixed(3)}function fit(el){if(!el)return;el.style.transform="scaleX(1)";const available=Math.max(0,el.clientWidth-2),needed=el.scrollWidth;if(needed>available&&needed>0)el.style.transform="scaleX("+Math.min(1,available/needed)+")"}function fitAll(){document.querySelectorAll(".athlete").forEach(fit);fit(meetTitle)}function settleFit(){requestAnimationFrame(()=>requestAnimationFrame(fitAll));setTimeout(fitAll,120)}function show(e,r,animate){const score=document.getElementById("score-"+e.key),name=document.getElementById("name-"+e.key),quad=document.getElementById("quad-"+e.key);score.textContent=formatScore(r.score);name.textContent=((r.first+" "+r.last).trim()||"Unknown Athlete");document.getElementById("gym-"+e.key).textContent=r.gym;document.getElementById("level-"+e.key).textContent=settings.showLevel?"Level "+(r.level||"---"):"";document.getElementById("division-"+e.key).textContent=settings.showDivision?"Div: "+(r.division||"---"):"";document.getElementById("number-"+e.key).textContent=settings.showNumber?"#"+(r.num||"---"):"";["level","division","number"].forEach(k=>document.getElementById(k+"-"+e.key).style.display=settings["show"+k.charAt(0).toUpperCase()+k.slice(1)]?"inline-block":"none");if(r.meet)meetTitle.textContent=settings.titleSource==="custom"&&settings.customMeetName?settings.customMeetName:r.meet;settleFit();if(animate)effect(e,r)}');
  Output.Writeln('function stopPerfectParticles(){if(particleFrame)cancelAnimationFrame(particleFrame);particleFrame=0;const ctx=perfectParticles.getContext("2d");ctx.clearRect(0,0,perfectParticles.width,perfectParticles.height)}function startPerfectParticles(){stopPerfectParticles();const ratio=Math.max(1,window.devicePixelRatio||1),rect=perfectParticles.getBoundingClientRect();perfectParticles.width=Math.max(1,Math.floor(rect.width*ratio));perfectParticles.height=Math.max(1,Math.floor(rect.height*ratio));const ctx=perfectParticles.getContext("2d");ctx.setTransform(ratio,0,0,ratio,0,0);const w=rect.width,h=rect.height,rockets=[],sparks=[];let started=performance.now(),nextLaunch=0;function launch(){const targetX=w*(.18+Math.random()*.64),targetY=h*(.12+Math.random()*.42),startX=w*(.08+Math.random()*.84);rockets.push({x:startX,y:h+10,vx:(targetX-startX)/46,vy:(targetY-h-10)/46,age:0,max:46,targetX:targetX,targetY:targetY})}function explode(x,y){const count=120+Math.floor(Math.random()*70);for(let i=0;i<count;i++){const angle=Math.random()*Math.PI*2,speed=2+Math.random()*6.8;sparks.push({x:x,y:y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,life:70+Math.random()*65,size:1.1+Math.random()*3.2,alpha:.68+Math.random()*.32,trail:Math.random()>.35})}}function draw(now){const elapsed=now-started;ctx.clearRect(0,0,w,h);ctx.globalCompositeOperation="lighter";if(elapsed<8800&&now>=nextLaunch){launch();nextLaunch=now+240+Math.random()*340}for(let i=rockets.length-1;i>=0;i--){const r=rockets[i];r.x+=r.vx;r.y+=r.vy;r.age++;ctx.beginPath();ctx.moveTo(r.x-r.vx*5,r.y-r.vy*5);ctx.lineTo(r.x,r.y);ctx.strokeStyle="rgba(255,210,95,.82)";ctx.lineWidth=2;ctx.stroke();if(r.age>=r.max){explode(r.targetX,r.targetY);rockets.splice(i,1)}}for(let i=sparks.length-1;i>=0;i--){const p=sparks[i],oldX=p.x,oldY=p.y;p.x+=p.vx;p.y+=p.vy;p.vy+=.035;p.vx*=.992;p.life--;p.alpha*=.982;if(p.life<=0||p.alpha<.02){sparks.splice(i,1);continue}if(p.trail){ctx.beginPath();ctx.moveTo(oldX,oldY);ctx.lineTo(p.x,p.y);ctx.strokeStyle="rgba(255,195,35,"+Math.max(0,p.alpha*.92)+")";ctx.lineWidth=Math.max(.6,p.size*.55);ctx.stroke()}ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fillStyle="rgba(255,220,125,"+Math.max(0,p.alpha)+")";ctx.fill()}if(elapsed<9800||rockets.length||sparks.length)particleFrame=requestAnimationFrame(draw)}launch();setTimeout(launch,240);particleFrame=requestAnimationFrame(draw)}');
  Output.Writeln('function clearPerfectCinematic(){if(perfectTimer){clearTimeout(perfectTimer);perfectTimer=null}perfectCinematic.classList.remove("active");perfectCinematic.setAttribute("aria-hidden","true");perfectCinematic.style.opacity="";perfectCinematic.style.visibility="";stopPerfectParticles()}function playPerfectCinematic(e,r){clearPerfectCinematic();perfectAthlete.textContent=((r.first+" "+r.last).trim()||"Perfect 10");perfectMeta.textContent=e.name+" • "+(r.gym||"Gymnastics");perfectCinematic.setAttribute("aria-hidden","false");perfectCinematic.style.visibility="visible";perfectCinematic.style.opacity="1";void perfectCinematic.offsetWidth;perfectCinematic.classList.add("active");setTimeout(startPerfectParticles,3000);perfectTimer=setTimeout(clearPerfectCinematic,12800)}function effect(e,r){const value=Number(r.score||0);if(value>=9.995&&settings.enablePerfectTen){playPerfectCinematic(e,r);return}if(settings.enableHighScoreEffects&&value>=Number(settings.highScoreMinimum||9.7)){const q=document.getElementById("quad-"+e.key);q.classList.remove("high");void q.offsetWidth;q.classList.add("high");setTimeout(()=>q.classList.remove("high"),7000)}}');
  Output.Writeln('function loadPurgeState(){try{return JSON.parse(localStorage.getItem(PURGE_KEY)||"{}")}catch(e){return{}}}function savePurgeState(){const saved={};EVENTS.forEach(e=>{const value=Number(state[e.key]&&state[e.key].purgedThrough||0);if(value>0)saved[e.key]=value});localStorage.setItem(PURGE_KEY,JSON.stringify(saved))}const purgeState=loadPurgeState(),state={};EVENTS.forEach(e=>state[e.key]={id:0,pending:null,shownAt:0,paused:false,record:null,first:true,busy:false,purging:false,purgedThrough:Number(purgeState[e.key]||0),commandAt:Date.now()});function newest(text){const records=String(text||"").split("~").map(x=>parse(x.trim())).filter(Boolean).filter(r=>Number(r.score)>0);records.sort((a,b)=>b.id-a.id);return records[0]||null}function clearEventDisplay(e){document.getElementById("score-"+e.key).textContent="0.000";document.getElementById("name-"+e.key).textContent="Waiting on Score";document.getElementById("gym-"+e.key).textContent="";["level","division","number"].forEach(k=>document.getElementById(k+"-"+e.key).textContent="");settleFit()}async function purgeEvent(e){const s=state[e.key];if(!s||s.purging)return;s.purging=true;let watermark=Math.max(Number(s.id||0),Number(s.pending&&s.pending.id||0),Number(s.purgedThrough||0));s.pending=null;s.record=null;s.shownAt=0;s.first=false;clearEventDisplay(e);try{const response=await fetch(e.feed+"?purge="+Date.now(),{cache:"no-store"});if(response.ok){const current=newest(await response.text());if(current)watermark=Math.max(watermark,Number(current.id||0))}}catch(err){}s.id=watermark;s.purgedThrough=watermark;savePurgeState();clearEventDisplay(e);s.purging=false}async function poll(e){const s=state[e.key];if(s.busy||s.paused||s.purging)return;s.busy=true;try{const response=await fetch(e.feed+"?t="+Date.now(),{cache:"no-store"});if(!response.ok)throw new Error(response.status);const r=newest(await response.text());if(s.purging)return;if(r&&r.id<=Number(s.purgedThrough||0)){s.id=Math.max(Number(s.id||0),Number(r.id||0));return}if(r&&r.id>Number(s.purgedThrough||0)){s.purgedThrough=0;savePurgeState()}if(r&&(r.id!==s.id)){if(s.first||!s.shownAt||Date.now()-s.shownAt>=Math.max(1,Number(settings.displaySeconds))*1000){s.id=r.id;s.record=r;s.shownAt=Date.now();show(e,r,!s.first);s.first=false}else{s.pending=r}}if(s.pending&&Date.now()-s.shownAt>=Math.max(1,Number(settings.displaySeconds))*1000){const p=s.pending;s.pending=null;s.id=p.id;s.record=p;s.shownAt=Date.now();show(e,p,true)}}catch(err){}finally{s.busy=false}}');
  Output.Writeln('function command(){let c;try{c=JSON.parse(localStorage.getItem(COMMAND_KEY)||"null")}catch(e){}if(!c||!c.at||c.at<=lastCommandAt)return;lastCommandAt=c.at;if(/^pause/.test(c.command)){const key=c.command.replace("pause","").toLowerCase(),s=state[key];if(s){s.paused=!s.paused;document.getElementById("quad-"+key).classList.toggle("is-paused",s.paused)}}else if(c.command==="replay"){EVENTS.forEach(e=>{const r=state[e.key].record;if(r&&Number(r.score)>=Number(settings.highScoreMinimum||9.7))effect(e,r)})}else if(c.command==="purgeAll"){EVENTS.forEach(purgeEvent)}else if(/^purge/.test(c.command)){const key=c.command.replace("purge","").toLowerCase(),event=EVENTS.find(e=>e.key===key);if(event)purgeEvent(event)}}function eventCommands(){EVENTS.forEach(e=>{let c;try{c=JSON.parse(localStorage.getItem(e.command)||"null")}catch(x){}const s=state[e.key];if(!c||!c.at||c.at<=(s.commandAt||0))return;s.commandAt=c.at;if(c.command==="purgeAllScores")purgeEvent(e)})}');
  Output.Writeln('function goFullScreen(){const el=document.documentElement;if(el.requestFullscreen)el.requestFullscreen();else if(el.webkitRequestFullscreen)el.webkitRequestFullscreen()}document.addEventListener("fullscreenchange",()=>fullscreenButton.style.display=document.fullscreenElement?"none":"block");window.addEventListener("storage",applySettings);window.addEventListener("resize",settleFit);if(new URLSearchParams(location.search).get("preview")==="1")document.body.classList.add("preview-mode");renderGrid();applySettings();new ResizeObserver(settleFit).observe(eventGrid);if(document.fonts&&document.fonts.ready)document.fonts.ready.then(settleFit);EVENTS.forEach(e=>poll(e));setInterval(()=>EVENTS.forEach(e=>poll(e)),500);setInterval(command,250);setInterval(eventCommands,250);setInterval(applySettings,1200);');
  Output.Writeln('</script></body></html>');
end.
