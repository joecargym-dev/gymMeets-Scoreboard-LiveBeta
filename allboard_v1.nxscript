<%
begin
  Output.Writeln('<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GymMeets Companion 4x1 Display v1.0</title>');
  Output.Writeln('<style>');
  Output.Writeln('*{box-sizing:border-box}html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#000;font-family:Arial,Helvetica,sans-serif}:root{--bg:#070b10;--score:#ffff00;--name:#f5f8ff;--info:#00e5e5;--divider:#fff}');
  Output.Writeln('#board{position:relative;width:100vw;height:100vh;padding:1vw;background:var(--bg);display:grid;grid-template-rows:9.5% minmax(0,1fr) 12%;gap:.65vw;color:#fff}#board.header-title{grid-template-rows:7% minmax(0,1fr) 12%}#board.header-hidden{grid-template-rows:minmax(0,1fr) 12%}#board.no-sponsor{grid-template-rows:9.5% minmax(0,1fr)}#board.header-title.no-sponsor{grid-template-rows:7% minmax(0,1fr)}#board.header-hidden.no-sponsor{grid-template-rows:minmax(0,1fr)}');
  Output.Writeln('.header{display:grid;grid-template-columns:20% minmax(0,1fr) 20%;align-items:center;border:1px solid #26313c;border-radius:12px;overflow:hidden;min-height:0}.logo-slot{height:100%;display:flex;align-items:center;justify-content:center;background:#000;overflow:hidden}.logo-slot img{width:100%;height:100%;object-fit:contain}.meet-title{text-align:center;font-size:3vw;font-weight:900;text-transform:uppercase;white-space:nowrap;overflow:hidden;line-height:1;padding:0 .8vw;border-bottom:2px solid #00cfe8;transform-origin:center center}.header-title .logo-slot{display:none}.header-title .header{grid-template-columns:1fr}.header-hidden .header{display:none}');
  Output.Writeln('.grid{position:relative;display:grid;grid-template-columns:1fr 1fr;grid-template-rows:1fr 1fr;min-height:0;overflow:hidden;border:1px solid #26313c;border-radius:12px}.grid:before,.grid:after{content:"";position:absolute;z-index:8;background:var(--divider);pointer-events:none}.grid:before{left:50%;top:1.5%;bottom:1.5%;width:2px;transform:translateX(-1px)}.grid:after{top:50%;left:1.5%;right:1.5%;height:2px;transform:translateY(-1px)}');
  Output.Writeln('.quad{position:relative;min-width:0;min-height:0;display:grid;grid-template-rows:minmax(0,58%) minmax(0,42%);padding:.45vw 1.15vw .7vw;overflow:hidden;container-type:size}.quad-top{display:grid;grid-template-columns:34% minmax(0,66%);align-items:center;gap:.35vw;min-height:0}.event-icon{width:100%;height:100%;object-fit:contain;transform:scale(1.42)}.score{font-size:9.8vw;line-height:.78;font-weight:900;text-align:right;letter-spacing:-.065em;color:var(--score);white-space:nowrap;transform:scaleX(1.04);transform-origin:right center;text-shadow:0 5px 18px rgba(255,215,0,.18)}');
  Output.Writeln('.quad-bottom{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:minmax(0,1fr) auto;gap:.15vw .6vw;align-items:end;min-height:0}.athlete{grid-column:1/-1;font-size:6.4vw;font-size:min(6.4vw,28cqh);line-height:1.02;font-weight:900;letter-spacing:-.052em;color:var(--name);white-space:nowrap;overflow:hidden;transform-origin:left center;padding:.04em 0 .1em}.gym{font-size:1.35vw;line-height:1;color:var(--info);font-weight:700;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}.meta{display:flex;justify-content:flex-end;gap:.35vw;white-space:nowrap}.pill{font-size:.82vw;line-height:1;font-weight:800;color:#ffff00;background:#000;border:1px solid #333;border-radius:999px;padding:.28vw .42vw}.paused{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.76);z-index:7;font-size:1.4vw;font-weight:900;color:#ffb84d;letter-spacing:.12em}.quad.is-paused .paused{display:flex}.quad.high{animation:highGlow 7s ease both}.quad.high:after{content:"EXCELLENT SCORE";position:absolute;top:.55vw;right:.65vw;z-index:9;background:#8b6400;color:#fff4bd;border:1px solid #ffd35b;border-radius:999px;padding:.28vw .55vw;font-size:.78vw;font-weight:900;letter-spacing:.08em}@keyframes highGlow{0%,100%{box-shadow:none}8%,88%{box-shadow:inset 0 0 0 5px #ffd700,inset 0 0 35px rgba(255,215,0,.45)}}');
  Output.Writeln('.sponsor{border:1px solid #bbb;border-radius:12px;overflow:hidden;background:#000;min-height:0}.sponsor img{display:block;width:100%;height:100%;object-fit:fill}.no-sponsor .sponsor{display:none}.version{position:fixed;right:.45vw;bottom:.2vw;z-index:30;color:#8f969f;font-size:.55vw;line-height:1;letter-spacing:.04em}.fullscreen{position:fixed;right:1vw;top:1vw;z-index:50;padding:.55vw .85vw;background:#05080c;color:#fff;border:1px solid #555;border-radius:8px;font-weight:700;cursor:pointer}.preview-mode .fullscreen{display:none!important}');
  Output.Writeln('#perfect{position:fixed;inset:0;z-index:100;display:none;align-items:center;justify-content:center;flex-direction:column;background:radial-gradient(circle at center,#422f00 0,#080600 58%,#000 100%);color:#ffd700;text-align:center}#perfect.active{display:flex;animation:perfectIn .7s ease both}#perfectEvent{font-size:2.8vw;letter-spacing:.25em;font-weight:900}#perfectScore{font-size:28vw;line-height:.8;font-weight:900;text-shadow:0 0 50px #ffb300}#perfectText{font-size:4vw;font-weight:900;color:#fff4bd;letter-spacing:.12em}@keyframes perfectIn{from{opacity:0;transform:scale(.96)}to{opacity:1;transform:scale(1)}}');
  Output.Writeln('</style></head><body>');
  Output.Writeln('<button class="fullscreen" id="fullscreenButton" onclick="goFullScreen()">Full Screen</button><div id="board"><div class="header"><div class="logo-slot"><img id="hostLogo" src="images/gymmeets-companion-logo.png"></div><div class="meet-title" id="meetTitle">GYMMEETS COMPANION</div><div class="logo-slot"><img id="scoringLogo" src="images/scoring-logo.png"></div></div><div class="grid" id="eventGrid"></div><div class="sponsor"><img id="sponsorImage" src="images/sponsor-banner.png"></div></div><div class="version">GMC v1.0 · 4x1</div><div id="perfect"><div id="perfectEvent"></div><div id="perfectScore">10.00</div><div id="perfectText">PERFECT 10</div></div>');
  Output.Writeln('<script>');
  Output.Writeln('const EVENTS=[{key:"vault",code:"VT",name:"VAULT",feed:"vaultdata_v1.nxscript",icon:"images/VT.png",command:"gymmeetsVaultCommandV1"},{key:"bars",code:"UB",name:"BARS",feed:"barsdata_v1.nxscript",icon:"images/UB.png",command:"gymmeetsBarsCommandV1"},{key:"beam",code:"BB",name:"BEAM",feed:"beamdata_v1.nxscript",icon:"images/BB.png",command:"gymmeetsBeamCommandV1"},{key:"floor",code:"FX",name:"FLOOR",feed:"floordata_v1.nxscript",icon:"images/FX.png",command:"gymmeetsFloorCommandV1"}];');
  Output.Writeln('const SETTINGS_KEY="gymmeetsAllSettingsV1",COMMAND_KEY="gymmeetsAllCommandV1",BRANDING_KEY="gymmeetsSharedBrandingV1";const defaults={displaySeconds:30,backgroundColor:"#070b10",scoreColor:"#ffff00",nameColor:"#f5f8ff",detailsColor:"#00e5e5",scoreFont:"Arial Black",nameFont:"Arial Black",detailsFont:"Arial",metadataFont:"Arial",metadataTextColor:"#ffff00",metadataBaseColor:"#000000",scoreSize:100,nameSize:100,iconSize:100,meetTitleColor:"#ffffff",meetTitleFont:"Arial Black",showNumber:true,showLevel:true,showDivision:true,showHostLogo:true,hostLogoData:"images/gymmeets-companion-logo.png",showScoringLogo:true,scoringLogoData:"images/scoring-logo.png",showSponsor:true,sponsorData:"images/sponsor-banner.png",titleSource:"proscore",headerMode:"full",customMeetName:"",enableHighScoreEffects:true,highScoreMinimum:9.7,enablePerfectTen:true};let settings={},perfectTimer=null,lastCommandAt=0;');
  Output.Writeln('function parse(t){const p=t.split("|"),id=parseInt(p[0]||"0",10);if(!id)return null;return{id:id,num:p[1]||"",session:p[2]||"",level:p[3]||"",first:p[4]||"",last:p[5]||"",score:p[6]||"0.000",gym:p[9]||"",division:p[10]||"",meet:p[15]||""}}');
  Output.Writeln('function loadSettings(){let local={},brand={};try{local=JSON.parse(localStorage.getItem(SETTINGS_KEY)||"{}")}catch(e){}try{brand=JSON.parse(localStorage.getItem(BRANDING_KEY)||"{}")}catch(e){}return Object.assign({},defaults,local,brand)}function luminance(hex){hex=String(hex||"#000000").replace("#","");if(hex.length===3)hex=hex.split("").map(c=>c+c).join("");const n=parseInt(hex,16)||0,r=(n>>16)&255,g=(n>>8)&255,b=n&255;return(.299*r+.587*g+.114*b)/255}');
  Output.Writeln('function renderGrid(){eventGrid.innerHTML=EVENTS.map(e=>`<section class="quad" id="quad-${e.key}"><div class="quad-top"><img class="event-icon" src="${e.icon}"><div class="score" id="score-${e.key}">0.000</div></div><div class="quad-bottom"><div class="athlete" id="name-${e.key}">Waiting on Score</div><div class="gym" id="gym-${e.key}"></div><div class="meta"><span class="pill" id="level-${e.key}"></span><span class="pill" id="division-${e.key}"></span><span class="pill" id="number-${e.key}"></span></div></div><div class="paused">${e.name} PAUSED</div></section>`).join("")}');
  Output.Writeln('function applySettings(){settings=loadSettings();board.style.setProperty("--bg",settings.backgroundColor);board.style.setProperty("--score",settings.scoreColor);board.style.setProperty("--name",settings.nameColor);board.style.setProperty("--info",settings.detailsColor);board.style.setProperty("--divider",luminance(settings.backgroundColor)>.58?"#000":"#fff");board.className=(settings.headerMode==="title"?"header-title ":settings.headerMode==="hidden"?"header-hidden ":"")+(settings.showSponsor?"":"no-sponsor");document.querySelectorAll(".score").forEach(x=>{x.style.fontFamily=settings.scoreFont;x.style.fontSize=(9.8*Number(settings.scoreSize||100)/100)+"vw"});document.querySelectorAll(".athlete").forEach(x=>{const n=Number(settings.nameSize||100)/100;x.style.fontFamily=settings.nameFont;x.style.fontSize="min("+(6.4*n)+"vw,"+(28*n)+"cqh)"});document.querySelectorAll(".gym").forEach(x=>x.style.fontFamily=settings.detailsFont);document.querySelectorAll(".pill").forEach(x=>{x.style.fontFamily=settings.metadataFont;x.style.color=settings.metadataTextColor;x.style.background=settings.metadataBaseColor});document.querySelectorAll(".event-icon").forEach(x=>x.style.transform="scale("+(1.42*Number(settings.iconSize||100)/100)+")");meetTitle.style.color=settings.meetTitleColor;meetTitle.style.fontFamily=settings.meetTitleFont;if(settings.titleSource==="custom"&&settings.customMeetName)meetTitle.textContent=settings.customMeetName;hostLogo.parentElement.style.display=settings.showHostLogo&&settings.headerMode==="full"?"flex":"none";scoringLogo.parentElement.style.display=settings.showScoringLogo&&settings.headerMode==="full"?"flex":"none";hostLogo.src=settings.hostLogoData||defaults.hostLogoData;scoringLogo.src=settings.scoringLogoData||defaults.scoringLogoData;sponsorImage.src=settings.sponsorData||defaults.sponsorData;requestAnimationFrame(()=>fit(meetTitle))}');
  Output.Writeln('function fit(el){el.style.transform="scaleX(1)";const available=el.clientWidth,needed=el.scrollWidth;if(needed>available&&needed>0)el.style.transform="scaleX("+Math.max(.48,available/needed)+")"}function show(e,r,animate){const score=document.getElementById("score-"+e.key),name=document.getElementById("name-"+e.key),quad=document.getElementById("quad-"+e.key);score.textContent=Number(r.score||0).toFixed(3);name.textContent=((r.first+" "+r.last).trim()||"Unknown Athlete");document.getElementById("gym-"+e.key).textContent=r.gym;document.getElementById("level-"+e.key).textContent=settings.showLevel?"Level "+(r.level||"---"):"";document.getElementById("division-"+e.key).textContent=settings.showDivision?"Div: "+(r.division||"---"):"";document.getElementById("number-"+e.key).textContent=settings.showNumber?"#"+(r.num||"---"):"";["level","division","number"].forEach(k=>document.getElementById(k+"-"+e.key).style.display=settings["show"+k.charAt(0).toUpperCase()+k.slice(1)]?"inline-block":"none");if(r.meet)meetTitle.textContent=settings.titleSource==="custom"&&settings.customMeetName?settings.customMeetName:r.meet;requestAnimationFrame(()=>{fit(name);fit(meetTitle)});if(animate)effect(e,r)}');
  Output.Writeln('function effect(e,r){const value=Number(r.score||0);if(value===10&&settings.enablePerfectTen){perfectEvent.textContent=e.name;perfect.classList.add("active");clearTimeout(perfectTimer);perfectTimer=setTimeout(()=>perfect.classList.remove("active"),7000);return}if(settings.enableHighScoreEffects&&value>=Number(settings.highScoreMinimum||9.7)){const q=document.getElementById("quad-"+e.key);q.classList.remove("high");void q.offsetWidth;q.classList.add("high");setTimeout(()=>q.classList.remove("high"),7000)}}');
  Output.Writeln('const state={};EVENTS.forEach(e=>state[e.key]={id:0,pending:null,shownAt:0,paused:false,record:null,first:true,busy:false});function newest(text){const records=String(text||"").split("~").map(x=>parse(x.trim())).filter(Boolean).filter(r=>Number(r.score)>0);records.sort((a,b)=>b.id-a.id);return records[0]||null}async function poll(e){const s=state[e.key];if(s.busy||s.paused)return;s.busy=true;try{const response=await fetch(e.feed+"?t="+Date.now(),{cache:"no-store"});if(!response.ok)throw new Error(response.status);const r=newest(await response.text());if(r&&(r.id!==s.id)){if(s.first||!s.shownAt||Date.now()-s.shownAt>=Math.max(1,Number(settings.displaySeconds))*1000){s.id=r.id;s.record=r;s.shownAt=Date.now();show(e,r,!s.first);s.first=false}else{s.pending=r}}if(s.pending&&Date.now()-s.shownAt>=Math.max(1,Number(settings.displaySeconds))*1000){const p=s.pending;s.pending=null;s.id=p.id;s.record=p;s.shownAt=Date.now();show(e,p,true)}}catch(err){}finally{s.busy=false}}');
  Output.Writeln('function command(){let c;try{c=JSON.parse(localStorage.getItem(COMMAND_KEY)||"null")}catch(e){}if(!c||!c.at||c.at<=lastCommandAt)return;lastCommandAt=c.at;if(/^pause/.test(c.command)){const key=c.command.replace("pause","").toLowerCase(),s=state[key];if(s){s.paused=!s.paused;document.getElementById("quad-"+key).classList.toggle("is-paused",s.paused)}}else if(c.command==="replay"){EVENTS.forEach(e=>{const r=state[e.key].record;if(r&&Number(r.score)>=Number(settings.highScoreMinimum||9.7))effect(e,r)})}}function eventCommands(){EVENTS.forEach(e=>{let c;try{c=JSON.parse(localStorage.getItem(e.command)||"null")}catch(x){}const s=state[e.key];if(!c||!c.at||c.at<=(s.commandAt||0))return;s.commandAt=c.at;if(c.command==="purgeAllScores"){s.id=0;s.pending=null;s.record=null;s.shownAt=0;s.first=true;document.getElementById("score-"+e.key).textContent="0.000";document.getElementById("name-"+e.key).textContent="Waiting on Score"}})}');
  Output.Writeln('function goFullScreen(){const el=document.documentElement;if(el.requestFullscreen)el.requestFullscreen();else if(el.webkitRequestFullscreen)el.webkitRequestFullscreen()}document.addEventListener("fullscreenchange",()=>fullscreenButton.style.display=document.fullscreenElement?"none":"block");window.addEventListener("storage",applySettings);if(new URLSearchParams(location.search).get("preview")==="1")document.body.classList.add("preview-mode");renderGrid();applySettings();new ResizeObserver(()=>requestAnimationFrame(()=>{document.querySelectorAll(".athlete").forEach(fit);fit(meetTitle)})).observe(eventGrid);EVENTS.forEach(e=>poll(e));setInterval(()=>EVENTS.forEach(e=>poll(e)),500);setInterval(command,250);setInterval(eventCommands,250);setInterval(applySettings,1200);');
  Output.Writeln('</script></body></html>');
end.
%>
