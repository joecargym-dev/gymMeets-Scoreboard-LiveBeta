  Output.Writeln('  <script>');
  Output.Writeln('    const SETTINGS_KEY="gymmeetsFloorSettingsV1",COMMAND_KEY="gymmeetsFloorCommandV1",DETECTED_MEET_KEY="gymmeetsDetectedMeetV4",SHARED_BRANDING_KEY="gymmeetsSharedBrandingV1";');
  Output.Writeln('    const defaults={displaySeconds:30,backgroundColor:"#070b10",scoreColor:"#ffff00",nameColor:"#f5f8ff",detailsColor:"#00e5e5",scoreFont:"Inter",nameFont:"Inter",detailsFont:"Inter",metadataFont:"Inter",metadataTextColor:"#ffff00",metadataBaseColor:"#000000",eventRibbonFont:"",eventRibbonTextColor:"",eventRibbonBaseColor:"",scoreSize:100,nameSize:100,iconSize:100,meetTitleColor:"#ffffff",meetTitleFont:"Inter",meetTitleSize:100,showNumber:true,showLevel:true,showDivision:true,showEventScores:true,showAA:true,showHostLogo:true,hostLogoData:"images/gymmeets-companion-logo.png",showScoringLogo:true,scoringLogoData:"images/scoring-logo.png",showSponsor:true,sponsorData:"images/sponsor-banner.png",sponsorItems:["images/sponsor-banner.png"],sponsorMode:"static",sponsorScrollSeconds:24,sponsorPosition:"bottom",titleSource:"proscore",headerMode:"full",splitBasicName:true,useCustomMeetName:false,customMeetName:"",meetName:"GymMeets Companion",gymName:"",divisionName:"Div: ---",enableHighScoreEffects:true,highScoreMinimum:9.7,enablePerfectTen:true};');
  Output.Writeln('    let currentDataID=0,currentSignature="",firstLoad=true,requestInProgress=false,proscoreMeetName="",proscoreMeetID=0,settings=loadSettings(),currentDisplayStartedAt=0,pendingRecord=null,cinematicActive=false,cinematicTimer=null,particleFrame=0,pendingPerfectRecord=null,currentRecord=null;');
  Output.Writeln('    const scoreboard=document.getElementById("scoreboard"),contentElement=document.querySelector(".content"),sponsorFrame=document.querySelector(".sponsor-frame"),scoreElement=document.getElementById("score"),athleteBlock=document.querySelector(".athlete-block"),athleteMeta=document.querySelector(".athlete-meta"),athleteName=document.getElementById("athleteName"),splitAthleteName=document.getElementById("splitAthleteName"),firstNameLine=document.getElementById("firstNameLine"),lastNameLine=document.getElementById("lastNameLine"),gymName=document.getElementById("gymName"),levelChip=document.getElementById("levelChip"),divisionChip=document.getElementById("divisionChip"),numberChip=document.getElementById("numberChip"),meetName=document.getElementById("meetName"),eventIconBox=document.getElementById("eventIconBox"),statusElement=document.getElementById("status"),hostLogo=document.getElementById("hostLogo"),scoringLogo=document.getElementById("scoringLogo"),sponsorBanner=document.getElementById("sponsorBanner"),sponsorMarquee=document.getElementById("sponsorMarquee"),sponsorTrack=document.getElementById("sponsorTrack"),sponsorPlaceholder=document.getElementById("sponsorPlaceholder"),vtScore=document.getElementById("vtScore"),ubScore=document.getElementById("ubScore"),bbScore=document.getElementById("bbScore"),fxScore=document.getElementById("fxScore"),aaScore=document.getElementById("aaScore"),resultsRibbon=document.querySelector(".results-ribbon"),aaCard=document.getElementById("aaCard"),eventCards=Array.from(document.querySelectorAll(".event-card")),scoreCallout=document.getElementById("scoreCallout"),perfectBanner=document.getElementById("perfectBanner"),celebrationLayer=document.getElementById("celebrationLayer"),perfectCinematic=document.getElementById("perfectCinematic"),perfectParticles=document.getElementById("perfectParticles"),perfectLogoWrap=document.getElementById("perfectLogoWrap"),perfectAthlete=document.getElementById("perfectAthlete"),perfectMeta=document.getElementById("perfectMeta"),resultTextElements=Array.from(document.querySelectorAll(".result-label,.result-value"));');
  Output.Writeln('    function loadSettings(){var eventSettings={},branding={},result;try{eventSettings=JSON.parse(localStorage.getItem(SETTINGS_KEY)||"{}");}catch(e){}try{branding=JSON.parse(localStorage.getItem(SHARED_BRANDING_KEY)||"{}");}catch(e){}result=Object.assign({},defaults,eventSettings,branding);if(result.hostLogoData==="images/host-logo.png")result.hostLogoData=defaults.hostLogoData;return result;}');
  Output.Writeln('    function toggleFullscreen(){const root=document.documentElement;if(!document.fullscreenElement){const request=root.requestFullscreen||root.webkitRequestFullscreen||root.msRequestFullscreen;if(!request){console.warn("Fullscreen is not supported in this browser.");return;}const result=request.call(root);if(result&&typeof result.catch==="function"){result.catch(function(error){console.warn("Could not enter fullscreen:",error);});}}else{const exit=document.exitFullscreen||document.webkitExitFullscreen||document.msExitFullscreen;if(exit)exit.call(document);}}');
  Output.Writeln('    function applyHeaderLogo(img,show,data,size){const scale=Math.max(.35,Math.min(1,Number(size||100)/100));img.style.transform="scale("+scale+")";if(show&&data){img.src=data;img.style.display="block"}else{img.style.display="none"}}');
  Output.Writeln('    function fitMeetName(){const base=2.25*Number(settings.meetTitleSize||100)/100;meetName.style.fontSize=base+"vw";let size=base;while(meetName.scrollWidth>meetName.clientWidth&&size>1.1){size-=.05;meetName.style.fontSize=size+"vw"}}');
  Output.Writeln('    function fitNameLine(el,baseSize,minSize){el.style.transform="none";el.style.fontSize=baseSize+"vw";let size=baseSize;while(el.scrollWidth>el.clientWidth&&size>minSize){size-=.05;el.style.fontSize=size+"vw"}if(el.scrollWidth>el.clientWidth){const ratio=Math.max(.84,el.clientWidth/el.scrollWidth);el.style.transform="scaleX("+ratio+")"}}');
  Output.Writeln('    function fitAthleteName(){const expanded=scoreboard.classList.contains("expanded-main"),split=expanded&&scoreboard.classList.contains("split-basic-name");if(split){const scale=Number(settings.nameSize||100)/100;fitNameLine(firstNameLine,8.6*scale,4.8);fitNameLine(lastNameLine,10.2*scale,5.2);return;}const baseSize=expanded?11.0:7.5;fitNameLine(athleteName,baseSize*Number(settings.nameSize||100)/100,4.1);}');
  Output.Writeln('    let sponsorRotationTimer=null,sponsorFadeTimer=null,sponsorIndex=0;');
  Output.Writeln('    function renderSponsors(){const items=Array.isArray(settings.sponsorItems)&&settings.sponsorItems.length?settings.sponsorItems:(settings.sponsorData?[settings.sponsorData]:[]);if(sponsorRotationTimer){clearInterval(sponsorRotationTimer);sponsorRotationTimer=null}if(sponsorFadeTimer){clearTimeout(sponsorFadeTimer);sponsorFadeTimer=null}sponsorMarquee.style.display="none";sponsorTrack.innerHTML="";sponsorBanner.style.objectFit="fill";sponsorBanner.style.transition="opacity .65s ease";sponsorBanner.style.opacity="1";if(!settings.showSponsor||!items.length){sponsorBanner.style.display="none";sponsorPlaceholder.style.display="block";return;}sponsorPlaceholder.style.display="none";sponsorIndex=0;sponsorBanner.src=items[0];sponsorBanner.style.display="block";if(settings.sponsorMode==="scroll"&&items.length>1){const displayTime=Math.max(3,Number(settings.sponsorScrollSeconds||8))*1000;sponsorRotationTimer=setInterval(function(){sponsorBanner.style.opacity="0";sponsorFadeTimer=setTimeout(function(){sponsorIndex=(sponsorIndex+1)%items.length;sponsorBanner.src=items[sponsorIndex];requestAnimationFrame(function(){sponsorBanner.style.opacity="1";});},650);},displayTime);}}');
  Output.Writeln('    function normalizeHexColor(value,fallback){const text=String(value||"").trim();if(/^#[0-9a-f]{6}$/i.test(text))return text;if(/^#[0-9a-f]{3}$/i.test(text))return "#"+text.slice(1).split("").map(function(c){return c+c}).join("");return fallback;}');
  Output.Writeln('    function shadeHex(value,amount){const hex=normalizeHexColor(value,"#000000"),num=parseInt(hex.slice(1),16),r=Math.max(0,Math.min(255,(num>>16)+amount)),g=Math.max(0,Math.min(255,((num>>8)&255)+amount)),b=Math.max(0,Math.min(255,(num&255)+amount));return "#"+[r,g,b].map(function(v){return v.toString(16).padStart(2,"0")}).join("");}');
  Output.Writeln('    function applyGeneratedSurface(element,baseColor){const base=normalizeHexColor(baseColor,"#000000");element.style.background="linear-gradient(180deg,"+shadeHex(base,18)+" 0%,"+base+" 52%,"+shadeHex(base,-14)+" 100%)";element.style.borderColor=shadeHex(base,32);element.style.boxShadow="0 1px 0 rgba(255,255,255,.12) inset,0 -1px 0 rgba(0,0,0,.34) inset,0 7px 16px rgba(0,0,0,.16)";}');
  Output.Writeln('    function applySettings(){settings=loadSettings();if(!settings.titleSource)settings.titleSource=settings.useCustomMeetName?"custom":"proscore";if(!settings.headerMode)settings.headerMode="full";const sponsorItems=Array.isArray(settings.sponsorItems)&&settings.sponsorItems.length?settings.sponsorItems:(settings.sponsorData?[settings.sponsorData]:[]);const sponsorVisible=!!settings.showSponsor&&sponsorItems.length>0;const ribbonVisible=!!settings.showEventScores||!!settings.showAA;const expandedMain=!sponsorVisible&&!ribbonVisible;scoreboard.classList.toggle("no-sponsor",!sponsorVisible);scoreboard.classList.toggle("expanded-main",expandedMain);scoreboard.classList.toggle("split-basic-name",expandedMain&&settings.splitBasicName!==false);scoreboard.classList.toggle("header-title",settings.headerMode==="title");scoreboard.classList.toggle("header-hidden",settings.headerMode==="hidden");contentElement.classList.toggle("no-ribbon",!ribbonVisible);document.documentElement.style.setProperty("--score",settings.scoreColor||defaults.scoreColor);document.documentElement.style.setProperty("--board-bg",settings.backgroundColor||defaults.backgroundColor);scoreboard.style.backgroundColor=settings.backgroundColor||defaults.backgroundColor;scoreElement.style.fontFamily=settings.scoreFont||defaults.scoreFont;const scoreBase=expandedMain?17.0:(!sponsorVisible||!ribbonVisible?14.65:13.4);scoreElement.style.fontSize=(scoreBase*Number(settings.scoreSize||100)/100)+"vw";athleteName.style.color=settings.nameColor||defaults.nameColor;athleteName.style.fontFamily=settings.nameFont||defaults.nameFont;[firstNameLine,lastNameLine].forEach(function(line){line.style.color=settings.nameColor||defaults.nameColor;line.style.fontFamily=settings.nameFont||defaults.nameFont;});const informationColor=settings.detailsColor||defaults.detailsColor;const informationFont=settings.detailsFont||defaults.detailsFont;const metadataFont=settings.metadataFont||informationFont;const metadataTextColor=settings.metadataTextColor||defaults.metadataTextColor;const metadataBaseColor=settings.metadataBaseColor||defaults.metadataBaseColor;const eventRibbonFont=settings.eventRibbonFont||informationFont;const eventRibbonTextColor=settings.eventRibbonTextColor||informationColor;const eventRibbonBaseColor=String(settings.eventRibbonBaseColor||"").trim();const hiddenCount=[settings.showLevel,settings.showDivision,settings.showNumber].filter(function(v){return !v;}).length;gymName.style.color=informationColor;gymName.style.fontFamily=informationFont;gymName.style.fontSize="min("+(expandedMain?3.1:2.65)+"vw,"+(expandedMain?5.15:4.4)+"vh)";[levelChip,divisionChip,numberChip].forEach(function(chip){chip.style.color=metadataTextColor;chip.style.fontFamily=metadataFont;applyGeneratedSurface(chip,metadataBaseColor);});resultTextElements.forEach(function(item){item.style.color=eventRibbonTextColor;item.style.fontFamily=eventRibbonFont;});[vtCard,ubCard,bbCard,fxCard,aaCard].forEach(function(card){if(eventRibbonBaseColor){applyGeneratedSurface(card,eventRibbonBaseColor);}else{card.style.background="";card.style.borderColor="";card.style.boxShadow="";}});eventIconBox.style.transform="scale("+(Number(settings.iconSize||100)/100)+")";const customTitle=String(settings.customMeetName||"").trim();meetName.textContent=settings.titleSource==="custom"&&customTitle?customTitle:(proscoreMeetName||defaults.meetName);meetName.style.color=settings.meetTitleColor||defaults.meetTitleColor;meetName.style.fontFamily=settings.meetTitleFont||defaults.meetTitleFont;numberChip.style.display=settings.showNumber?"block":"none";levelChip.style.display=settings.showLevel?"block":"none";divisionChip.style.display=settings.showDivision?"block":"none";athleteMeta.style.display=hiddenCount===3?"none":"flex";athleteBlock.style.gridTemplateColumns="minmax(0,1fr) auto";eventCards.forEach(function(card){card.style.display=settings.showEventScores?"flex":"none";});aaCard.style.display=settings.showAA?"flex":"none";resultsRibbon.style.display=ribbonVisible?"grid":"none";resultsRibbon.style.gridTemplateColumns=settings.showEventScores?(settings.showAA?"repeat(4,minmax(0,1fr)) minmax(0,1.18fr)":"repeat(4,minmax(0,1fr))"):"minmax(0,1fr)";applyHeaderLogo(hostLogo,settings.showHostLogo&&settings.headerMode==="full",settings.hostLogoData,100);applyHeaderLogo(scoringLogo,settings.showScoringLogo&&settings.headerMode==="full",settings.scoringLogoData,100);renderSponsors();requestAnimationFrame(function(){fitMeetName();fitAthleteName();});}');
  Output.Writeln('    function parseScoreRecord(t){const p=t.split("|"),id=parseInt(p[0]||"0",10);if(!id)return null;return{dataID:id,competitorNumber:p[1]||"",sessionNumber:p[2]||"",levelName:p[3]||"",firstName:p[4]||"",lastName:p[5]||"",score:p[6]||"0.000",aa:p[7]||"",aaPlace:p[8]||"",gymName:p[9]||"",division:p[10]||"",vt:p[11]||"",ub:p[12]||"",bb:p[13]||"",fx:p[14]||"",meetName:p[15]||"",meetID:parseInt(p[16]||"0",10)||0}}');
  Output.Writeln('    function replayAnimation(){scoreboard.classList.remove("new-score");void scoreboard.offsetWidth;scoreboard.classList.add("new-score");window.setTimeout(function(){scoreboard.classList.remove("new-score")},1900)}');
  Output.Writeln('    function stopPerfectParticles(){if(particleFrame)cancelAnimationFrame(particleFrame);particleFrame=0;const ctx=perfectParticles.getContext("2d");ctx.clearRect(0,0,perfectParticles.width,perfectParticles.height)}');
  Output.Writeln('    function startPerfectParticles(){stopPerfectParticles();const ratio=Math.max(1,window.devicePixelRatio||1),rect=perfectParticles.getBoundingClientRect();perfectParticles.width=Math.max(1,Math.floor(rect.width*ratio));perfectParticles.height=Math.max(1,Math.floor(rect.height*ratio));const ctx=perfectParticles.getContext("2d");ctx.setTransform(ratio,0,0,ratio,0,0);const w=rect.width,h=rect.height,rockets=[],sparks=[];let started=performance.now(),nextLaunch=0;function launch(){const targetX=w*(.18+Math.random()*.64),targetY=h*(.12+Math.random()*.42),startX=w*(.08+Math.random()*.84);rockets.push({x:startX,y:h+10,vx:(targetX-startX)/46,vy:(targetY-h-10)/46,age:0,max:46,targetX:targetX,targetY:targetY})}function explode(x,y){const count=120+Math.floor(Math.random()*70);for(let i=0;i<count;i++){const angle=Math.random()*Math.PI*2,speed=2.0+Math.random()*6.8;sparks.push({x:x,y:y,vx:Math.cos(angle)*speed,vy:Math.sin(angle)*speed,life:70+Math.random()*65,size:1.1+Math.random()*3.2,alpha:.68+Math.random()*.32,trail:Math.random()>.35})}}function draw(now){const elapsed=now-started;ctx.clearRect(0,0,w,h);ctx.globalCompositeOperation="lighter";if(elapsed<8800&&elapsed>=0&&now>=nextLaunch){launch();nextLaunch=now+(240+Math.random()*340)}for(let i=rockets.length-1;i>=0;i--){const r=rockets[i];r.x+=r.vx;r.y+=r.vy;r.age++;ctx.beginPath();ctx.moveTo(r.x-r.vx*5,r.y-r.vy*5);ctx.lineTo(r.x,r.y);ctx.strokeStyle="rgba(255,210,95,.82)";ctx.lineWidth=2;ctx.stroke();if(r.age>=r.max){explode(r.targetX,r.targetY);rockets.splice(i,1)}}for(let i=sparks.length-1;i>=0;i--){const p=sparks[i],oldX=p.x,oldY=p.y;p.x+=p.vx;p.y+=p.vy;p.vy+=.035;p.vx*=.992;p.life--;p.alpha*=.982;if(p.life<=0||p.alpha<.02){sparks.splice(i,1);continue}if(p.trail){ctx.beginPath();ctx.moveTo(oldX,oldY);ctx.lineTo(p.x,p.y);ctx.strokeStyle="rgba(255,195,35,"+Math.max(0,p.alpha*.92)+")";ctx.lineWidth=Math.max(.6,p.size*.55);ctx.stroke()}ctx.beginPath();ctx.arc(p.x,p.y,p.size,0,Math.PI*2);ctx.fillStyle="rgba(255,220,125,"+Math.max(0,p.alpha)+")";ctx.fill()}if(elapsed<9800||rockets.length||sparks.length)particleFrame=requestAnimationFrame(draw)}launch();window.setTimeout(launch,240);particleFrame=requestAnimationFrame(draw)}');
  Output.Writeln('    function clearPerfectCinematic(){if(cinematicTimer){clearTimeout(cinematicTimer);cinematicTimer=null}cinematicActive=false;scoreboard.classList.remove("cinematic-fade");perfectCinematic.classList.remove("active");perfectCinematic.setAttribute("aria-hidden","true");scoreboard.style.opacity="";perfectCinematic.style.opacity="";perfectCinematic.style.visibility="";stopPerfectParticles()}');
  Output.Writeln('    function playPerfectCinematic(record){clearPerfectCinematic();clearCelebration();clearPerfectFinal();pendingPerfectRecord=record;cinematicActive=true;perfectAthlete.textContent=((record.firstName||"")+" "+(record.lastName||"")).trim()||"Perfect 10";perfectMeta.textContent="FLOOR • "+((record.gymName||settings.gymName||"").trim()||"Gymnastics");perfectCinematic.setAttribute("aria-hidden","false");perfectCinematic.style.visibility="visible";perfectCinematic.style.opacity="1";scoreboard.style.opacity="0";void perfectCinematic.offsetWidth;perfectCinematic.classList.add("active");window.setTimeout(startPerfectParticles,3000);cinematicTimer=window.setTimeout(function(){const finalRecord=pendingPerfectRecord;pendingPerfectRecord=null;if(finalRecord)commitScoreToBoard(finalRecord,false,true);scoreboard.classList.add("perfect-final");perfectBanner.classList.add("persist");perfectBanner.setAttribute("aria-hidden","false");perfectCinematic.classList.remove("active");perfectCinematic.style.opacity="0";scoreboard.style.opacity="1";window.setTimeout(function(){clearPerfectCinematic();currentDisplayStartedAt=Date.now()},850)},12000)}');
  Output.Writeln('    function clearCelebration(){scoreboard.classList.remove("high-score","perfect-score");perfectBanner.classList.remove("show");perfectBanner.style.animation="";celebrationLayer.innerHTML=""}');
  Output.Writeln('    function clearPerfectFinal(){scoreboard.classList.remove("perfect-final");perfectBanner.classList.remove("persist");perfectBanner.setAttribute("aria-hidden","true")}');
  Output.Writeln('    function launchCelebration(scoreValue,record){const numeric=parseFloat(scoreValue),isPerfect=Number.isFinite(numeric)&&numeric>=9.995,minimum=Math.max(0,Math.min(10,Number(settings.highScoreMinimum==null?9.7:settings.highScoreMinimum)));if(!Number.isFinite(numeric))return;if(isPerfect&&settings.enablePerfectTen!==false){playPerfectCinematic(record||currentRecord||{firstName:firstNameLine.textContent,lastName:lastNameLine.textContent,gymName:gymName.textContent,score:scoreElement.textContent});return;}if(settings.enableHighScoreEffects===false||numeric<minimum)return;clearCelebration();scoreCallout.textContent="Excellent Score";const count=22;for(let i=0;i<count;i++){const spark=document.createElement("i");spark.className="spark";const fromLeft=52+Math.random()*44,fromTop=12+Math.random()*34;const angle=Math.random()*Math.PI*2,distance=105+Math.random()*155;spark.style.left=fromLeft+"%";spark.style.top=fromTop+"%";spark.style.setProperty("--dx",Math.cos(angle)*distance+"px");spark.style.setProperty("--dy",Math.sin(angle)*distance+"px");spark.style.animationDelay=(Math.random()*.2)+"s";celebrationLayer.appendChild(spark)}void scoreboard.offsetWidth;scoreboard.classList.add("high-score");window.setTimeout(clearCelebration,1750)}');
  Output.Writeln('    function formatDisplayScore(value){const text=String(value==null?"":value).trim();if(!text)return"---";const numeric=parseFloat(text);return Number.isFinite(numeric)&&Math.abs(numeric-10)<.0005?"10.00":text;}');
  Output.Writeln('    function showValue(el,value){el.textContent=formatDisplayScore(value)}');
  Output.Writeln('    function commitScoreToBoard(r,animate,keepPerfect){if(!r)return;currentRecord=Object.assign({},r);if(!keepPerfect)clearPerfectFinal();currentDataID=r.dataID;currentSignature=recordSignature(r);if(r.meetName){proscoreMeetName=r.meetName;}if(r.meetID){proscoreMeetID=r.meetID;}try{localStorage.setItem(DETECTED_MEET_KEY,JSON.stringify({meetID:proscoreMeetID,meetName:proscoreMeetName,updatedAt:Date.now()}));}catch(e){}applySettings();scoreElement.textContent=formatDisplayScore(r.score);currentDisplayStartedAt=Date.now();pendingRecord=null;const first=(r.firstName||"").trim(),last=(r.lastName||"").trim();athleteName.textContent=(first+" "+last).trim()||"Unknown Athlete";firstNameLine.textContent=first||"Unknown";lastNameLine.textContent=last||"Athlete";requestAnimationFrame(fitAthleteName);const resolvedGym=(r.gymName||settings.gymName||"").trim();gymName.textContent=resolvedGym;gymName.style.display=resolvedGym?"block":"none";levelChip.textContent="Level "+(r.levelName||"---");divisionChip.textContent="Div: "+(r.division||String(settings.divisionName||"---").replace(/^Div(?:ision)?\s*:?\s*/i,"")||"---");numberChip.textContent="#"+(r.competitorNumber||"---");showValue(vtScore,r.vt||r.score);showValue(ubScore,r.ub);showValue(bbScore,r.bb);showValue(fxScore,r.fx);showValue(aaScore,r.aa);if(animate){replayAnimation();launchCelebration(r.score,r)}}');
  Output.Writeln('    function displayScore(r,animate){if(!r)return;currentRecord=Object.assign({},r);const numericScore=parseFloat(r.score),isPerfect=animate&&settings.enablePerfectTen!==false&&Number.isFinite(numericScore)&&numericScore>=9.995;if(isPerfect){currentDataID=r.dataID;currentSignature=recordSignature(r);pendingRecord=null;playPerfectCinematic(r);return}commitScoreToBoard(r,animate,false)}');
  Output.Writeln('    function recordSignature(r){return [r.score,r.aa,r.aaPlace,r.vt,r.ub,r.bb,r.fx,r.division,r.levelName,r.competitorNumber].join("|")}');
  Output.Writeln('    function newestRecord(records){if(!records.length)return null;records.sort((a,b)=>b.dataID-a.dataID);return records[0]}');
  Output.Writeln('    async function fetchScoreData(){let response;try{response=await fetch("floordata_v1.nxscript?t="+Date.now(),{cache:"no-store"});if(response.ok)return(await response.text()).trim();}catch(e){}response=await fetch("floordata.nxscript?t="+Date.now(),{cache:"no-store"});if(!response.ok)throw new Error("Data feed returned HTTP "+response.status);return(await response.text()).trim();}');
  Output.Writeln('    function minimumDisplayMilliseconds(){return Math.max(1,Number(settings.displaySeconds||defaults.displaySeconds))*1000;}');
  Output.Writeln('    function canAdvanceScore(){return !cinematicActive&&(!currentDisplayStartedAt||Date.now()-currentDisplayStartedAt>=minimumDisplayMilliseconds());}');
  Output.Writeln('    function releasePendingScore(force){if(!pendingRecord||cinematicActive)return false;if(force||canAdvanceScore()){const record=pendingRecord;pendingRecord=null;displayScore(record,true);return true;}return false;}');
  Output.Writeln('    async function checkForScores(){if(requestInProgress)return;requestInProgress=true;try{const result=await fetchScoreData(),texts=result?result.split("~"):[],records=[];texts.forEach(t=>{const r=parseScoreRecord(t.trim());if(r)records.push(r)});const latest=newestRecord(records);if(latest){const latestSignature=recordSignature(latest);if(firstLoad){displayScore(latest,false);firstLoad=false}else if(latest.dataID!==currentDataID||latestSignature!==currentSignature){pendingRecord=latest;releasePendingScore(false)}else{releasePendingScore(false)}}else{firstLoad=false;statusElement.textContent="Connected, but no Vault scores were found";statusElement.classList.add("error");return;}statusElement.textContent="";statusElement.classList.remove("error")}catch(e){statusElement.textContent="Score connection interrupted: "+e.message;statusElement.classList.add("error")}finally{requestInProgress=false}}');
  Output.Writeln('    function replayCurrentEffect(){applySettings();const record=currentRecord||{firstName:firstNameLine.textContent,lastName:lastNameLine.textContent,gymName:gymName.textContent,score:scoreElement.textContent,vt:vtScore.textContent,ub:ubScore.textContent,bb:bbScore.textContent,fx:fxScore.textContent,aa:aaScore.textContent};const numeric=parseFloat(record.score);clearPerfectCinematic();clearCelebration();clearPerfectFinal();if(Number.isFinite(numeric)&&numeric>=9.995&&settings.enablePerfectTen!==false){playPerfectCinematic(record);return}replayAnimation();if(Number.isFinite(numeric))launchCelebration(numeric,record)}');
  Output.Writeln('    function handleCommand(){try{const c=JSON.parse(localStorage.getItem(COMMAND_KEY)||"{}");if(!c.at||c.at===handleCommand.last)return;handleCommand.last=c.at;if(c.command==="next"){releasePendingScore(true)}else if(c.command==="replay"){replayCurrentEffect()}}catch(e){}}');
  Output.Writeln('    window.addEventListener("storage",e=>{if(e.key===SETTINGS_KEY||e.key===SHARED_BRANDING_KEY)applySettings();if(e.key===COMMAND_KEY)handleCommand()});');
  Output.Writeln('    window.addEventListener("resize",()=>{fitMeetName();fitAthleteName()});');
  Output.Writeln('    document.addEventListener("fullscreenchange",function(){const button=document.getElementById("fullscreenButton");if(button)button.style.display=document.fullscreenElement?"none":"block";});');
  Output.Writeln('    document.addEventListener("webkitfullscreenchange",function(){const button=document.getElementById("fullscreenButton");if(button)button.style.display=(document.fullscreenElement||document.webkitFullscreenElement)?"none":"block";});');
  Output.Writeln('    if(new URLSearchParams(window.location.search).get("preview")==="1")document.body.classList.add("preview-mode");applySettings();checkForScores();setInterval(checkForScores,500);setInterval(handleCommand,250);setInterval(function(){releasePendingScore(false)},200);');
  Output.Writeln('  </script>');
  Output.Writeln('</body>');
  Output.Writeln('</html>');
end.
%>
