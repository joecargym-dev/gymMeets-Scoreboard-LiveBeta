  Output.Writeln('    <div id="perfectLogoWrap" class="perfect-logo-wrap" aria-label="Perfect 10 emblem"><div class="cinematic-ten">10</div><div class="cinematic-perfect-badge"><span>★</span><strong>PERFECT 10</strong><span>★</span></div></div>');
  Output.Writeln('    <div id="perfectRecognition" class="perfect-recognition"><div id="perfectAthlete" class="perfect-athlete"></div><div id="perfectMeta" class="perfect-meta"></div></div>');
