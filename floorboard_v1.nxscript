<%
begin
  Output.Writeln('<!DOCTYPE html>');
  Output.Writeln('<html lang="en">');
  Output.Writeln('<head>');
  Output.Writeln('  <meta charset="utf-8">');
  Output.Writeln('  <meta name="viewport" content="width=device-width,initial-scale=1">');
  Output.Writeln('  <title>GymMeets Companion - Floor V4.20</title>');
  Output.Writeln('  <style>');
  Output.Writeln('    :root{');
  Output.Writeln('      --bg:#070b10;');
  Output.Writeln('      --panel:#101722;');
  Output.Writeln('      --panel-2:#151f2d;');
  Output.Writeln('      --line:#2d3d52;');
  Output.Writeln('      --accent:#1aa7ff;');
  Output.Writeln('      --accent-2:#00e5e5;');
  Output.Writeln('      --score:#ffff00;');
  Output.Writeln('      --text:#ffffff;');
  Output.Writeln('      --muted:#b8c4d3;');
  Output.Writeln('      --radius:18px;');
  Output.Writeln('      --shadow:0 20px 50px rgba(0,0,0,.42),0 0 0 1px rgba(255,255,255,.04) inset;');
  Output.Writeln('      --board-bg:#070b10;');
  Output.Writeln('    }');
  Output.Writeln('    *{box-sizing:border-box}');
  Output.Writeln('    html,body{width:100%;height:100%;margin:0;overflow:hidden;background:#000}');
  Output.Writeln('    body{font-family:Inter,"Segoe UI",Arial,Helvetica,sans-serif;color:var(--text)}');
  Output.Writeln('    #scoreboard{');
  Output.Writeln('      width:100%;height:100%;padding:1.4vw;display:grid;');
  Output.Writeln('      grid-template-rows:12% 1fr 15%;gap:1.05vw;');
  Output.Writeln('      background:var(--board-bg);');
  Output.Writeln('    }');
  Output.Writeln('    .frame{border:1px solid rgba(255,255,255,.12);border-radius:var(--radius);background:var(--board-bg);box-shadow:var(--shadow)}');
  Output.Writeln('    .header{display:grid;grid-template-columns:20% minmax(0,1fr) 20%;align-items:center;padding:.32vw .72vw;position:relative;overflow:hidden}');
  Output.Writeln('    .header:after{content:"";position:absolute;left:0;right:0;bottom:0;height:3px;background:linear-gradient(90deg,transparent,var(--accent),var(--accent-2),transparent);opacity:.82}');
  Output.Writeln('    .logo-slot{width:100%;height:100%;min-width:0;display:flex;align-items:center;justify-content:center;padding:0;overflow:hidden;border:0;background:transparent}');
  Output.Writeln('    .logo-slot.right{justify-content:center}');
  Output.Writeln('    .header-logo{display:none;width:105%;height:105%;max-width:none;max-height:none;object-fit:contain;object-position:center center;filter:drop-shadow(0 4px 10px rgba(0,0,0,.45));margin:0;padding:0;transform:none}');
  Output.Writeln('    #meetName{text-align:center;font-size:2.25vw;font-weight:800;line-height:1;letter-spacing:.025em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:0 .75vw}');
  Output.Writeln('    .content{display:grid;grid-template-rows:minmax(0,.92fr) minmax(0,1.05fr) minmax(92px,.38fr);gap:.72vw;padding:1.0vw 1.25vw .72vw;overflow:hidden}');
  Output.Writeln('    #scoreboard.no-sponsor{grid-template-rows:12% 1fr}');
  Output.Writeln('    #scoreboard.header-title{grid-template-rows:8% 1fr 15%}');
  Output.Writeln('    #scoreboard.header-title.no-sponsor{grid-template-rows:8% 1fr}');
  Output.Writeln('    #scoreboard.header-title .header{grid-template-columns:minmax(0,1fr);padding:.18vw 1vw}');
  Output.Writeln('    #scoreboard.header-title .logo-slot{display:none}');
  Output.Writeln('    #scoreboard.header-title #meetName{font-size:1.85vw}');
  Output.Writeln('    #scoreboard.header-hidden{grid-template-rows:1fr 15%}');
  Output.Writeln('    #scoreboard.header-hidden.no-sponsor{grid-template-rows:1fr}');
  Output.Writeln('    #scoreboard.header-hidden .header{display:none}');
  Output.Writeln('    #scoreboard.no-sponsor .sponsor-frame{display:none}');
  Output.Writeln('    .content.no-ribbon{grid-template-rows:minmax(0,1.28fr) minmax(0,.82fr);gap:.9vw;padding:1.35vw 1.5vw 1.15vw}');
  Output.Writeln('    #scoreboard.no-sponsor .content{padding-top:1.35vw;padding-bottom:1.05vw}');
  Output.Writeln('    #scoreboard.no-sponsor .content.no-ribbon{grid-template-rows:minmax(0,.88fr) minmax(0,1.22fr);gap:.55vw;padding:.75vw 1.65vw 1.25vw}');
  Output.Writeln('    .score-row{display:flex;align-items:center;justify-content:space-between;gap:3vw;min-height:0;padding:0 1.2vw}');
  Output.Writeln('    .event-icon-box{width:25vw;height:10.5vw;min-width:250px;min-height:105px;max-width:500px;max-height:210px;margin-left:1vw;border-radius:16px;border:0;background:transparent;display:flex;align-items:center;justify-content:center;box-shadow:none;flex:0 0 auto;overflow:hidden}');
  Output.Writeln('    .event-icon{width:100%;height:100%;max-width:none;max-height:none;object-fit:contain;display:block;transform:scale(1.55);transform-origin:center;flex:0 0 auto}');
  Output.Writeln('    #score{font-size:13.4vw;text-align:right;font-weight:900;line-height:.80;letter-spacing:-.055em;color:var(--score);white-space:nowrap;text-shadow:0 8px 26px rgba(255,43,43,.18);transform:scaleX(1.08);transform-origin:right center}');
  Output.Writeln('    .athlete-block{display:grid;grid-template-columns:minmax(0,1fr) auto;grid-template-rows:minmax(0,1fr) auto;align-items:end;column-gap:1.2vw;row-gap:.12vw;min-height:0;padding:.35vw .5vw .3vw;overflow:hidden}');
  Output.Writeln('    .athlete-main{display:contents}');
  Output.Writeln('    #athleteName{grid-column:1 / -1;grid-row:1;font-size:7.1vw;line-height:1.02;font-weight:900;color:#f5f8ff;white-space:nowrap;overflow:hidden;letter-spacing:-.045em;padding:.04em 0 .08em;transform-origin:left center;min-width:0}');
  Output.Writeln('    #splitAthleteName{display:none;grid-column:1 / -1;grid-row:1;align-self:stretch;min-width:0;overflow:hidden;flex-direction:column;justify-content:center;padding:.05vw 0 .12vw}');
  Output.Writeln('    .split-name-line{display:block;white-space:nowrap;overflow:hidden;line-height:.82;font-weight:900;letter-spacing:-.055em;transform-origin:left center;min-width:0}');
  Output.Writeln('    #firstNameLine{font-size:8.6vw}');
  Output.Writeln('    #lastNameLine{font-size:10.2vw}');
  Output.Writeln('    #scoreboard.expanded-main.split-basic-name #athleteName{display:none}');
  Output.Writeln('    #scoreboard.expanded-main.split-basic-name #splitAthleteName{display:flex}');
  Output.Writeln('    #gymName{grid-column:1;grid-row:2;margin-top:0;font-size:2.65vw;line-height:1;font-weight:700;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;padding:.04em 0 .1em;max-width:100%;min-width:0}');
  Output.Writeln('    #scoreboard.expanded-main .score-row{align-items:center;padding-top:.35vw;padding-bottom:.15vw}');
  Output.Writeln('    #scoreboard.expanded-main .event-icon-box{width:27vw;height:11.5vw;max-width:540px;max-height:230px}');
  Output.Writeln('    #scoreboard.expanded-main .athlete-block{padding-bottom:.55vw}');
  Output.Writeln('    #scoreboard.expanded-main.split-basic-name .athlete-block{grid-template-rows:minmax(0,1fr) auto;padding-top:0;padding-bottom:.45vw}');
  Output.Writeln('    .athlete-meta{grid-column:2;grid-row:2;display:flex;align-items:flex-end;justify-content:flex-end;gap:.7vw;flex-wrap:nowrap;padding-bottom:.12vw;min-width:0}');
  Output.Writeln('    .meta-chip{font-size:min(1.55vw,2.75vh);line-height:1;font-weight:800;padding:.48vw .72vw;border-radius:999px;border:1px solid rgba(255,255,255,.12);background:#000;white-space:nowrap}');
  Output.Writeln('    .results-ribbon{display:grid;grid-template-columns:repeat(4,minmax(0,1fr)) minmax(0,1.18fr);gap:.65vw;align-items:stretch;min-height:92px;height:100%;overflow:visible}');
  Output.Writeln('    .result-card{border:1px solid rgba(255,255,255,.12);border-radius:12px;background:linear-gradient(180deg,rgba(255,255,255,.075),rgba(255,255,255,.03));display:flex;flex-direction:column;justify-content:center;align-items:center;gap:.18vw;padding:.35vw .45vw;min-height:0;height:100%;box-shadow:0 8px 18px rgba(0,0,0,.18) inset}');
  Output.Writeln('    .result-card.current{border-color:rgba(26,167,255,.9);box-shadow:0 0 0 1px rgba(26,167,255,.36) inset,0 0 22px rgba(26,167,255,.18)}');
  Output.Writeln('    .result-label{font-size:1.70vw;font-weight:900;letter-spacing:.05em;line-height:1}');
  Output.Writeln('    .result-value{font-size:2.40vw;font-weight:900;white-space:nowrap;line-height:1}');
  Output.Writeln('    .sponsor-frame{position:relative;overflow:hidden;display:flex;align-items:center;justify-content:center;background:#eef2f6;border-color:rgba(255,255,255,.2)}');
  Output.Writeln('    #sponsorBanner{position:absolute;inset:0;width:100%;height:100%;display:none;object-fit:fill;opacity:1;transition:opacity .65s ease}');
  Output.Writeln('    #sponsorPlaceholder{font-size:1.5vw;font-weight:800;color:#5d6a78;letter-spacing:.08em;text-transform:uppercase}');
  Output.Writeln('    .sponsor-marquee{position:absolute;inset:0;display:none;overflow:hidden;align-items:center}');
  Output.Writeln('    .sponsor-track{display:flex;align-items:center;height:100%;width:max-content;will-change:transform;animation:sponsorScroll 24s linear infinite}');
  Output.Writeln('    .sponsor-item{height:100%;width:auto;min-width:22vw;max-width:42vw;object-fit:contain;padding:.55vw 1.6vw;flex:0 0 auto}');
  Output.Writeln('    @keyframes sponsorScroll{from{transform:translateX(0)}to{transform:translateX(-50%)}}');
  Output.Writeln('    #status{position:fixed;left:1.8vw;bottom:1vw;color:#ff8585;font-size:12px;opacity:0;z-index:10}');
  Output.Writeln('    .version-marker{position:fixed;right:.7vw;bottom:.45vw;z-index:12;font-size:.62vw;font-weight:700;letter-spacing:.08em;color:rgba(255,255,255,.34);pointer-events:none}');
  Output.Writeln('    #status.error{opacity:1}');
  Output.Writeln('    #scoreboard.new-score .content{animation:scoreArrival 430ms cubic-bezier(.2,.8,.2,1)}');
  Output.Writeln('    #scoreboard.new-score #score{animation:scorePulse 430ms cubic-bezier(.2,.8,.2,1)}');
  Output.Writeln('    @keyframes scoreArrival{0%{transform:scale(.985);filter:brightness(.88)}65%{transform:scale(1.006);filter:brightness(1.08)}100%{transform:scale(1);filter:brightness(1)}}');
  Output.Writeln('    @keyframes scorePulse{0%{transform:translateY(8px) scale(.965);opacity:.35}70%{transform:translateY(0) scale(1.018);opacity:1}100%{transform:scale(1)}}');
  Output.Writeln('    .celebration-layer{position:fixed;inset:0;pointer-events:none;overflow:hidden;z-index:20;display:none}');
  Output.Writeln('    #scoreboard.high-score ~ .celebration-layer{display:block}');
  Output.Writeln('    #scoreboard.high-score #score{color:#ffd34f;text-shadow:0 0 16px rgba(255,211,79,.78),0 0 42px rgba(255,166,0,.48),0 10px 28px rgba(0,0,0,.5);animation:highScorePop 1.25s cubic-bezier(.18,.89,.32,1.28)}');
  Output.Writeln('    #scoreboard.high-score .content{box-shadow:0 0 0 2px rgba(255,211,79,.78) inset,0 0 44px rgba(255,190,45,.2),var(--shadow);animation:highScoreFrame 1.45s ease-out}');
  Output.Writeln('    #scoreboard.high-score .content:after{content:"";position:absolute;inset:0;pointer-events:none;background:linear-gradient(105deg,transparent 0%,transparent 36%,rgba(255,255,255,.04) 42%,rgba(255,235,145,.52) 49%,rgba(255,255,255,.1) 55%,transparent 62%,transparent 100%);transform:translateX(-125%);animation:goldSweep 1.15s ease-out}');
  Output.Writeln('    .content{position:relative}');
  Output.Writeln('    .score-callout{position:absolute;top:14.5%;left:50%;transform:translate(-50%,-20px) scale(.9);padding:.48vw 1.15vw;border-radius:999px;background:linear-gradient(90deg,#ffd34f,#fff0a6,#ffd34f);color:#261800;font-size:1.12vw;font-weight:1000;letter-spacing:.12em;text-transform:uppercase;opacity:0;z-index:25;box-shadow:0 8px 28px rgba(255,190,45,.35)}');
  Output.Writeln('    #scoreboard.high-score ~ .score-callout{animation:calloutIn 1.6s ease-out}');
  Output.Writeln('    #scoreboard.perfect-score ~ .score-callout{background:linear-gradient(90deg,#00e5e5,#ffffff,#ffd34f);font-size:1.35vw}');
  Output.Writeln('    .perfect-banner{position:fixed;left:72%;top:37.8%;transform:translate(-50%,-50%) scale(.68);min-width:25vw;padding:.42vw 1.25vw;border-radius:999px;border:3px solid rgba(255,255,255,.95);background:linear-gradient(100deg,#00d9e8 0%,#ffffff 45%,#ffd34f 72%,#ffb300 100%);color:#07111b;font-size:2.25vw;line-height:1;font-weight:1000;letter-spacing:.075em;text-align:center;text-transform:uppercase;white-space:nowrap;opacity:0;visibility:hidden;z-index:9999;box-shadow:0 0 0 4px rgba(0,229,229,.22),0 0 34px rgba(0,229,229,.62),0 0 68px rgba(255,211,79,.52),0 14px 34px rgba(0,0,0,.58);pointer-events:none}');
  Output.Writeln('    .perfect-banner.show{visibility:visible;animation:perfectPlaque 2.65s cubic-bezier(.16,.84,.24,1) forwards}');
  Output.Writeln('    .perfect-banner.persist{visibility:visible;opacity:1;transform:translate(-50%,-50%) scale(.72);animation:none}');
  Output.Writeln('    #scoreboard.perfect-final #score{color:#fff!important;text-shadow:0 0 3px rgba(115,255,174,1),0 0 8px rgba(115,255,174,.88),0 0 18px rgba(255,216,92,.96),0 0 38px rgba(255,188,35,.68),0 0 68px rgba(255,226,145,.34),0 7px 18px rgba(0,0,0,.62)}');
  Output.Writeln('    #scoreboard.perfect-score #score{color:#ffffff;text-shadow:0 0 3px rgba(115,255,174,1),0 0 9px rgba(115,255,174,.9),0 0 20px rgba(255,216,92,.98),0 0 42px rgba(255,188,35,.7),0 0 74px rgba(255,226,145,.36),0 10px 28px rgba(0,0,0,.58);animation:perfectScorePop 2.05s cubic-bezier(.18,.89,.32,1.28)}');
  Output.Writeln('    #scoreboard.perfect-score .content{animation:perfectFrame 2.1s ease-out;box-shadow:0 0 0 3px rgba(255,255,255,.92) inset,0 0 28px rgba(255,205,70,.42),0 0 64px rgba(255,220,120,.24),var(--shadow)}');
  Output.Writeln('    .spark{position:absolute;width:9px;height:9px;border-radius:2px;background:#ffd34f;box-shadow:0 0 13px currentColor;opacity:0;animation:sparkBurst 1.25s ease-out forwards}');
  Output.Writeln('    .spark:nth-child(3n){background:#00e5e5}.spark:nth-child(4n){background:#fff}.spark:nth-child(5n){border-radius:50%}');
  Output.Writeln('    @keyframes highScorePop{0%{transform:scaleX(1.08) scale(.88);filter:brightness(.75)}36%{transform:scaleX(1.13) scale(1.08);filter:brightness(1.45)}62%{transform:scaleX(1.07) scale(.985)}100%{transform:scaleX(1.08) scale(1);filter:brightness(1)}}');
  Output.Writeln('    @keyframes highScoreFrame{0%{filter:brightness(.9)}35%{filter:brightness(1.22)}100%{filter:brightness(1)}}');
  Output.Writeln('    @keyframes goldSweep{0%{transform:translateX(-125%)}100%{transform:translateX(125%)}}');
  Output.Writeln('    @keyframes calloutIn{0%{opacity:0;transform:translate(-50%,-22px) scale(.82)}18%{opacity:1;transform:translate(-50%,0) scale(1.05)}68%{opacity:1;transform:translate(-50%,0) scale(1)}100%{opacity:0;transform:translate(-50%,-7px) scale(.96)}}');
  Output.Writeln('    @keyframes sparkBurst{0%{opacity:0;transform:translate(0,0) rotate(0deg) scale(.4)}16%{opacity:1}100%{opacity:0;transform:translate(var(--dx),var(--dy)) rotate(300deg) scale(1.1)}}');
  Output.Writeln('    @keyframes perfectScorePop{0%{transform:scaleX(1.08) scale(.68);opacity:.25;filter:brightness(.7)}20%{transform:scaleX(1.16) scale(1.13);opacity:1;filter:brightness(1.8)}42%{transform:scaleX(1.07) scale(.98)}62%{transform:scaleX(1.12) scale(1.045)}100%{transform:scaleX(1.08) scale(1);filter:brightness(1)}}');
  Output.Writeln('    @keyframes perfectFrame{0%{filter:brightness(.78)}20%{filter:brightness(1.42)}45%{filter:brightness(1)}64%{filter:brightness(1.24)}100%{filter:brightness(1)}}');
  Output.Writeln('    @keyframes perfectPlaque{0%{opacity:0;transform:translate(-50%,-50%) scale(.55)}14%{opacity:1;transform:translate(-50%,-50%) scale(1.08)}26%{opacity:1;transform:translate(-50%,-50%) scale(.98)}72%{opacity:1;transform:translate(-50%,-50%) scale(1)}100%{opacity:0;transform:translate(-50%,-88%) scale(.92)}}');
  Output.Writeln('    .perfect-cinematic{position:fixed;inset:0;z-index:10000;background:#000;opacity:0;visibility:hidden;pointer-events:none;overflow:hidden}');
  Output.Writeln('    .perfect-cinematic.active{visibility:visible;animation:cinematicLayer 12.8s linear forwards}');
  Output.Writeln('    .perfect-cinematic canvas{position:absolute;inset:0;width:100%;height:100%}');
  Output.Writeln('    .perfect-logo-wrap{position:absolute;left:50%;top:50%;width:min(84vw,142vh);height:min(82vh,46vw);transform:translate(-50%,-50%) scale(.9);opacity:0;will-change:transform,opacity;display:flex;align-items:center;justify-content:center}');
  Output.Writeln('    .perfect-cinematic.active .perfect-logo-wrap{animation:perfectLogoJourney 12.8s cubic-bezier(.22,.8,.25,1) forwards}');
  Output.Writeln('    .cinematic-ten{position:absolute;left:50%;top:44%;transform:translate(-50%,-50%);font-family:Arial Black,Arial,sans-serif;font-size:min(49vw,82vh);line-height:.72;font-weight:1000;letter-spacing:-.09em;color:#fff;text-shadow:0 0 3px rgba(115,255,174,1),0 0 9px rgba(115,255,174,.9),0 0 22px rgba(255,216,92,.98),0 0 46px rgba(255,188,35,.72),0 0 82px rgba(255,226,145,.38),0 8px 18px rgba(0,0,0,.85)}');
  Output.Writeln('    .cinematic-perfect-badge{position:absolute;left:50%;top:56%;transform:translate(-50%,-50%);min-width:47%;padding:.7vh 2.2vw;border:3px solid rgba(255,255,255,.9);border-radius:999px;background:linear-gradient(90deg,#11d5e7 0%,#aef4ef 42%,#ffe36d 68%,#ffb70f 100%);box-shadow:0 0 10px rgba(88,255,239,.95),0 0 26px rgba(255,190,35,.7);display:flex;align-items:center;justify-content:center;gap:1.4vw;color:#061019;white-space:nowrap}');
  Output.Writeln('    .cinematic-perfect-badge strong{font-family:Arial Black,Arial,sans-serif;font-size:min(3.9vw,6.2vh);line-height:1;font-weight:1000;letter-spacing:.035em}');
  Output.Writeln('    .cinematic-perfect-badge span{font-size:min(3.2vw,5.2vh);line-height:1}');
  Output.Writeln('    .perfect-recognition{position:absolute;left:2vw;right:2vw;bottom:4vh;text-align:center;opacity:0;transform:translateY(30px);color:#fff;text-shadow:0 4px 18px #000}');
  Output.Writeln('    .perfect-cinematic.active .perfect-recognition{animation:perfectRecognition 12.8s ease forwards}');
  Output.Writeln('    .perfect-athlete{font-size:min(9.6vw,14.5vh);line-height:.92;font-weight:1000;letter-spacing:-.045em;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}');
  Output.Writeln('    .perfect-meta{margin-top:1.9vh;font-size:min(3.35vw,5.5vh);line-height:1.05;font-weight:900;letter-spacing:.055em;text-transform:uppercase;color:#ffd75c}');
  Output.Writeln('    #scoreboard.cinematic-fade{animation:boardToBlack 12.8s linear forwards}');
  Output.Writeln('    @keyframes boardToBlack{0%{opacity:1}3.9%{opacity:0}93.8%{opacity:0}100%{opacity:1}}');
  Output.Writeln('    @keyframes cinematicLayer{0%{opacity:0}3.9%,93.8%{opacity:1}100%{opacity:0}}');
  Output.Writeln('    @keyframes perfectLogoJourney{0%,23.4%{opacity:0;top:52%;transform:translate(-50%,-50%) scale(.9)}31.3%{opacity:1;top:52%;transform:translate(-50%,-50%) scale(1.01)}54.7%{opacity:1;top:52%;transform:translate(-50%,-50%) scale(.98)}62.5%{opacity:1;top:34%;transform:translate(-50%,-50%) scale(.95)}93.8%{opacity:1;top:34%;transform:translate(-50%,-50%) scale(.95)}100%{opacity:0;top:34%;transform:translate(-50%,-50%) scale(.95)}}');
  Output.Writeln('    @keyframes perfectRecognition{0%,57%{opacity:0;transform:translateY(30px)}63%,93.8%{opacity:1;transform:translateY(0)}100%{opacity:0;transform:translateY(-12px)}}');
  Output.Writeln('    @media (prefers-reduced-motion:reduce){#scoreboard.new-score .content,#scoreboard.new-score #score,#scoreboard.high-score #score,#scoreboard.high-score .content,#scoreboard.high-score .content:after,#scoreboard.high-score ~ .score-callout,.perfect-banner.show,.spark{animation:none}.celebration-layer{display:none!important}}');
  Output.Writeln('    .fullscreen-btn{position:fixed;top:16px;right:16px;z-index:99999;padding:10px 16px;border:1px solid rgba(255,255,255,.25);border-radius:8px;background:rgba(0,0,0,.55);color:#fff;font:600 14px Arial,sans-serif;cursor:pointer;backdrop-filter:blur(6px);transition:background .2s,opacity .2s}');
  Output.Writeln('    .fullscreen-btn:hover{background:rgba(47,129,247,.9)}');
  Output.Writeln('    .fullscreen-btn:focus-visible{outline:2px solid #fff;outline-offset:2px}');
  Output.Writeln('    body.preview-mode .fullscreen-btn{display:none!important}');
  Output.Writeln('  </style>');
  Output.Writeln('</head>');
  Output.Writeln('<body>');
  Output.Writeln('  <button id="fullscreenButton" class="fullscreen-btn" type="button" onclick="toggleFullscreen()">Full Screen</button>');
  Output.Writeln('  <main id="scoreboard">');
  Output.Writeln('    <header class="header frame">');
  Output.Writeln('      <div class="logo-slot"><img id="hostLogo" class="header-logo" alt="Host club logo"></div>');
  Output.Writeln('      <div id="meetName">GymMeets Companion</div>');
  Output.Writeln('      <div class="logo-slot right"><img id="scoringLogo" class="header-logo" alt="Scoring company logo"></div>');
  Output.Writeln('    </header>');
  Output.Writeln('    <section class="content frame">');
  Output.Writeln('      <div class="score-row">');
  Output.Writeln('        <div class="event-icon-box" id="eventIconBox"><img class="event-icon" src="images/FX.png" alt="Floor"></div>');
  Output.Writeln('        <div id="score">0.000</div>');
  Output.Writeln('      </div>');
  Output.Writeln('      <div class="athlete-block">');
  Output.Writeln('        <div class="athlete-main">');
