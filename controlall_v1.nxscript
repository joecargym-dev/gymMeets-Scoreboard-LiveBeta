<%
begin
  Output.Writeln('<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GymMeets Companion 4x1 Control v1.0</title><style>');
  Output.Writeln('*{box-sizing:border-box}:root{color-scheme:dark}body{margin:0;background:#17191d;color:#f4f4f4;font-family:Arial,Helvetica,sans-serif}header{position:sticky;top:0;z-index:50;padding:16px 22px;background:rgba(14,16,19,.96);border-bottom:1px solid #343840;display:flex;justify-content:space-between;align-items:center}header h1{margin:0;font-size:23px}.status{font-size:13px;color:#7ee787}.layout{display:grid;grid-template-columns:minmax(370px,540px) 1fr;gap:18px;padding:18px}.panel{background:#22262c;border:1px solid #3a4048;border-radius:11px;padding:16px;margin-bottom:16px;box-shadow:0 8px 24px rgba(0,0,0,.14)}.panel h2{margin:0 0 14px;font-size:18px}.panel h3{margin:17px 0 8px;padding-top:13px;border-top:1px solid #3a4048;font-size:13px;color:#8cbfff;text-transform:uppercase;letter-spacing:.08em}.row{display:grid;grid-template-columns:1fr 170px;gap:12px;align-items:center;margin:10px 0}.row.wide{grid-template-columns:1fr}label{font-size:14px;color:#d8d8d8}input[type=number],input[type=text],select{width:100%;padding:9px;border-radius:6px;border:1px solid #565d67;background:#111419;color:#fff}input[type=color]{width:100%;height:38px;padding:2px;border-radius:6px;border:1px solid #565d67;background:#111419}input[type=range],input[type=file]{width:100%}.switch{position:relative;display:inline-block;width:48px;height:26px}.switch input{position:absolute;opacity:0}.slider{display:block;position:absolute;inset:0;background:#555;border-radius:20px;cursor:pointer}.slider:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:.2s}.switch input:checked+.slider{background:#2f81f7}.switch input:checked+.slider:before{transform:translateX(22px)}.switch-row{display:flex;justify-content:space-between;align-items:center;margin:10px 0}.buttons{display:flex;flex-wrap:wrap;gap:9px;margin-top:14px}button{padding:9px 13px;border-radius:6px;border:1px solid #5c6470;background:#303640;color:#fff;cursor:pointer}button.primary{background:#2f81f7;border-color:#2f81f7}button.danger{background:#a61f2b;border-color:#dc4653;font-weight:700}.preview-wrap{position:sticky;top:78px;align-self:start}.preview-title{display:flex;justify-content:space-between;align-items:flex-start;gap:12px;margin-bottom:10px}.preview-actions{display:flex;flex-wrap:wrap;justify-content:flex-end;gap:8px}.preview{position:relative;width:100%;aspect-ratio:16/9;border:1px solid #3a4048;border-radius:10px;overflow:hidden;background:#000}.preview iframe{position:absolute;left:0;top:0;width:1920px;height:1080px;border:0;transform-origin:top left}.note{font-size:12px;color:#aab1bb;line-height:1.5}.value{color:#8cbfff;font-weight:bold}.danger-panel{border-color:#71313a;background:#2b2024}.danger-panel h2{color:#ff9199}.editing-banner{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:16px;padding:12px 14px;border:1px solid #3f566f;border-radius:9px;background:#151d27}.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.78);display:none;align-items:center;justify-content:center;padding:20px;z-index:9999}.modal-backdrop.show{display:flex}.modal{width:min(590px,100%);background:#20242a;border:1px solid #e04b57;border-radius:12px;padding:20px}.modal h2{margin:0 0 10px;color:#ff9199}.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}.confirm-input{width:100%;padding:10px;border-radius:6px;border:1px solid #6c737d;background:#111419;color:#fff;font-weight:700}@media(max-width:1000px){.layout{grid-template-columns:1fr}.preview-wrap{position:static}}</style></head><body>');
  Output.Writeln('<header><h1>GymMeets Companion <span style="color:#8cbfff">4x1 Control</span> <span style="font-size:13px;color:#aab1bb">v1.0</span></h1><div class="status" id="status">Settings ready</div></header><div class="layout"><main><div class="editing-banner"><div><span class="note">EDITING BOARD</span><br><strong style="color:#8cbfff;font-size:16px">All Events — 4x1</strong></div><button class="primary" onclick="openBoard()">Open 4x1 Display</button></div>');
  Output.Writeln('<section class="panel"><h2>Meet Display Title</h2><div class="row"><label>Display title source</label><select id="titleSource"><option value="proscore">Use ProScore meet title</option><option value="custom">Use custom display title</option></select></div><div class="row wide"><label>Custom display title</label><input id="customMeetName" type="text"></div><div class="row"><label>Header layout</label><select id="headerMode"><option value="full">Full: logos and title</option><option value="title">Title only</option><option value="hidden">Hidden</option></select></div><div class="row"><label>Title color</label><input id="meetTitleColor" type="color"></div><div class="row"><label>Title font</label><select id="meetTitleFont"></select></div></section>');
  Output.Writeln('<section class="panel"><h2>Display Controls</h2><div class="row"><label>Display time for every event (seconds)</label><input id="displaySeconds" type="number" min="1" max="300"></div><p class="note">The same minimum display time applies independently to Vault, Bars, Beam and Floor.</p><div class="buttons"><button class="primary" onclick="save(true)">Save Settings</button></div></section>');
  Output.Writeln('<section class="panel"><h2>Appearance</h2><h3 style="margin-top:0;padding-top:0;border-top:0">Colors</h3><div class="row"><label>Background color</label><input id="backgroundColor" type="color"></div><div class="row"><label>Score color</label><input id="scoreColor" type="color"></div><div class="row"><label>Athlete name color</label><input id="nameColor" type="color"></div><div class="row"><label>Information color</label><input id="detailsColor" type="color"></div><h3>Fonts</h3><div class="row"><label>Score font</label><select id="scoreFont"></select></div><div class="row"><label>Athlete name font</label><select id="nameFont"></select></div><div class="row"><label>Information font</label><select id="detailsFont"></select></div><h3>Sizes</h3><div class="row wide"><label>Score size <span class="value" id="scoreSizeValue"></span></label><input id="scoreSize" type="range" min="60" max="140" step="5"></div><div class="row wide"><label>Athlete name maximum size <span class="value" id="nameSizeValue"></span></label><input id="nameSize" type="range" min="60" max="140" step="5"></div><div class="row wide"><label>Event icon size <span class="value" id="iconSizeValue"></span></label><input id="iconSize" type="range" min="60" max="140" step="5"></div></section>');
  Output.Writeln('<section class="panel"><h2>Information Display</h2><div class="switch-row"><label>Show level</label><label class="switch"><input id="showLevel" type="checkbox"><span class="slider"></span></label></div><div class="switch-row"><label>Show division</label><label class="switch"><input id="showDivision" type="checkbox"><span class="slider"></span></label></div><div class="switch-row"><label>Show competitor number</label><label class="switch"><input id="showNumber" type="checkbox"><span class="slider"></span></label></div><p class="note">The 4x1 display intentionally has no event score ribbon.</p></section>');
  Output.Writeln('<section class="panel"><h2>Metadata</h2><div class="row"><label>Pill font</label><select id="metadataFont"></select></div><div class="row"><label>Pill text color</label><input id="metadataTextColor" type="color"></div><div class="row"><label>Pill base color</label><input id="metadataBaseColor" type="color"></div></section>');
  Output.Writeln('<section class="panel"><h2>Score Effects</h2><div class="switch-row"><label>Enable high-score effect</label><label class="switch"><input id="enableHighScoreEffects" type="checkbox"><span class="slider"></span></label></div><div class="row"><label>Minimum score to trigger</label><input id="highScoreMinimum" type="number" min="0" max="10" step=".05"></div><div class="switch-row"><label>Enable full-screen Perfect 10 celebration</label><label class="switch"><input id="enablePerfectTen" type="checkbox"><span class="slider"></span></label></div><p class="note">A high score highlights its quadrant. A Perfect 10 temporarily takes over the entire display, then the 4x1 view resumes.</p></section>');
  Output.Writeln('<section class="panel"><h2>Branding & Sponsors</h2><div class="switch-row"><label>Show left header logo</label><label class="switch"><input id="showHostLogo" type="checkbox"><span class="slider"></span></label></div><div class="row wide"><label>Left header logo</label><input id="hostLogoFile" type="file" accept="image/*"></div><div class="switch-row"><label>Show right header logo</label><label class="switch"><input id="showScoringLogo" type="checkbox"><span class="slider"></span></label></div><div class="row wide"><label>Right header logo</label><input id="scoringLogoFile" type="file" accept="image/*"></div><div class="switch-row"><label>Show sponsor banner</label><label class="switch"><input id="showSponsor" type="checkbox"><span class="slider"></span></label></div><div class="row wide"><label>Sponsor banner</label><input id="sponsorFile" type="file" accept="image/*"></div></section>');
  Output.Writeln('<section class="panel danger-panel"><h2>Advanced / Maintenance</h2><p class="note"><strong>These commands may also affect additional displays for the selected event that use the same browser profile.</strong> They clear only GymMeets display queues. Scores are not removed from or modified in the ProScore database.</p><div class="buttons"><button class="danger purge-action" data-target="vault">Purge Vault</button><button class="danger purge-action" data-target="bars">Purge Bars</button><button class="danger purge-action" data-target="beam">Purge Beam</button><button class="danger purge-action" data-target="floor">Purge Floor</button><button class="danger purge-action" data-target="all">Purge All</button></div></section></main>');
  Output.Writeln('<aside class="preview-wrap"><div class="preview-title"><h2 style="margin:0">Preview 4x1</h2><div class="preview-actions"><button onclick="pause(\''Vault\'')">Pause Vault</button><button onclick="pause(\''Bars\'')">Pause Bars</button><button onclick="pause(\''Beam\'')">Pause Beam</button><button onclick="pause(\''Floor\'')">Pause Floor</button><button onclick="replay()">Replay Current Effect</button><button onclick="resetDefaults()">Reset View to Default</button><button onclick="refreshPreview()">Refresh Preview</button></div></div><div class="preview"><iframe id="previewFrame" src="allboard_v1.nxscript?preview=1"></iframe></div><p class="note">Paused quadrants retain their current score while the other events continue normally.</p></aside></div>');
  Output.Writeln('<div class="modal-backdrop" id="purgeModal"><div class="modal"><h2 id="purgeTitle">Purge display queue?</h2><p id="purgeText"></p><p><strong>No scores or meet data inside ProScore will be modified or deleted.</strong></p><p>Type <strong>CLEAR</strong> to confirm.</p><input id="confirmText" class="confirm-input"><div class="modal-actions"><button onclick="closePurge()">Cancel</button><button class="danger" id="confirmButton" disabled onclick="confirmPurge()">Purge Queue</button></div></div></div>');
  Output.Writeln('<script>');
  Output.Writeln('const KEY="gymmeetsAllSettingsV1",COMMAND="gymmeetsAllCommandV1",BRANDING="gymmeetsSharedBrandingV1";const defaults={displaySeconds:30,backgroundColor:"#070b10",scoreColor:"#ffff00",nameColor:"#f5f8ff",detailsColor:"#00e5e5",scoreFont:"Arial Black",nameFont:"Arial Black",detailsFont:"Arial",metadataFont:"Arial",metadataTextColor:"#ffff00",metadataBaseColor:"#000000",scoreSize:100,nameSize:100,iconSize:100,meetTitleColor:"#ffffff",meetTitleFont:"Arial Black",showNumber:true,showLevel:true,showDivision:true,showHostLogo:true,showScoringLogo:true,showSponsor:true,titleSource:"proscore",headerMode:"full",customMeetName:"",enableHighScoreEffects:true,highScoreMinimum:9.7,enablePerfectTen:true};const brandingDefaults={hostLogoData:"images/gymmeets-companion-logo.png",scoringLogoData:"images/scoring-logo.png",sponsorData:"images/sponsor-banner.png"};let purgeTarget="";const byId=id=>document.getElementById(id);');
  Output.Writeln('function load(){let a={},b={};try{a=JSON.parse(localStorage.getItem(KEY)||"{}")}catch(e){}try{b=JSON.parse(localStorage.getItem(BRANDING)||"{}")}catch(e){}return Object.assign({},defaults,a,brandingDefaults,b)}function store(s){const b={hostLogoData:s.hostLogoData,scoringLogoData:s.scoringLogoData,sponsorData:s.sponsorData};localStorage.setItem(BRANDING,JSON.stringify(Object.assign({},brandingDefaults,b)));delete s.hostLogoData;delete s.scoringLogoData;delete s.sponsorData;localStorage.setItem(KEY,JSON.stringify(s))}');
  Output.Writeln('const fields=["displaySeconds","backgroundColor","scoreColor","nameColor","detailsColor","scoreFont","nameFont","detailsFont","metadataFont","metadataTextColor","metadataBaseColor","scoreSize","nameSize","iconSize","meetTitleColor","meetTitleFont","showNumber","showLevel","showDivision","showHostLogo","showScoringLogo","showSponsor","titleSource","headerMode","customMeetName","enableHighScoreEffects","highScoreMinimum","enablePerfectTen"];function form(s){fields.forEach(k=>{const e=byId(k);if(!e)return;if(e.type==="checkbox")e.checked=!!s[k];else e.value=s[k]});values()}function read(){const s=load();fields.forEach(k=>{const e=byId(k);if(!e)return;if(e.type==="checkbox")s[k]=e.checked;else if(e.type==="number"||e.type==="range")s[k]=Number(e.value);else s[k]=e.value});return s}');
  Output.Writeln('function status(t){byId("status").textContent=t;clearTimeout(status.timer);status.timer=setTimeout(()=>byId("status").textContent="Settings ready",1700)}function save(notify){store(read());if(notify)status("4x1 settings saved")}function values(){["scoreSize","nameSize","iconSize"].forEach(k=>byId(k+"Value").textContent=byId(k).value+"%")}function sizePreview(){const box=document.querySelector(".preview"),f=byId("previewFrame");f.style.transform="scale("+Math.min(box.clientWidth/1920,box.clientHeight/1080)+")"}');
  Output.Writeln('function fonts(){const names=["Arial Black","Arial","Verdana","Tahoma","Trebuchet MS","Georgia","Impact"];["scoreFont","nameFont","detailsFont","metadataFont","meetTitleFont"].forEach(id=>byId(id).innerHTML=names.map(n=>`<option>${n}</option>`).join(""))}function refreshPreview(){const f=byId("previewFrame");f.src="allboard_v1.nxscript?preview=1&t="+Date.now();setTimeout(sizePreview,80);status("Preview refreshed")}function openBoard(){const w=window.open("allboard_v1.nxscript","GymMeetsAllBoard","popup,resizable=yes,width=1600,height=900");if(w)w.focus()}');
  Output.Writeln('function send(command,key){localStorage.setItem(key||COMMAND,JSON.stringify({command:command,at:Date.now()}))}function pause(name){send("pause"+name);status(name+" pause toggled")}function replay(){send("replay");status("Eligible score effects replayed")}function resetDefaults(){store(Object.assign({},defaults,brandingDefaults));form(load());refreshPreview();status("Default 4x1 view restored")}');
  Output.Writeln('function image(input,key){const file=input.files&&input.files[0];if(!file)return;const reader=new FileReader();reader.onload=()=>{const s=load();s[key]=reader.result;store(s);input.value="";refreshPreview();status("Branding image updated")};reader.readAsDataURL(file)}function openPurge(target){purgeTarget=target;const label=target==="all"?"all four event":""+target.charAt(0).toUpperCase()+target.slice(1);byId("purgeTitle").textContent="Purge "+label+" queue";byId("purgeText").textContent=target==="all"?"This clears the GymMeets display queues for Vault, Bars, Beam and Floor.":"This clears the GymMeets "+label+" queue. Additional "+label+" displays using this browser profile may also be affected.";byId("confirmText").value="";byId("confirmButton").disabled=true;byId("purgeModal").classList.add("show")}function closePurge(){byId("purgeModal").classList.remove("show")}');
  Output.Writeln('function confirmPurge(){if(byId("confirmText").value.trim().toUpperCase()!=="CLEAR")return;const map={vault:"gymmeetsVaultCommandV1",bars:"gymmeetsBarsCommandV1",beam:"gymmeetsBeamCommandV1",floor:"gymmeetsFloorCommandV1"},targets=purgeTarget==="all"?Object.keys(map):[purgeTarget];send(purgeTarget==="all"?"purgeAll":"purge"+purgeTarget.charAt(0).toUpperCase()+purgeTarget.slice(1));targets.forEach(k=>send("purgeAllScores",map[k]));closePurge();status(purgeTarget==="all"?"All four GymMeets display queues cleared":"Selected GymMeets display queue cleared")}');
  Output.Writeln('fonts();form(load());document.querySelectorAll("input,select").forEach(e=>{if(e.type==="file"||e.id==="confirmText")return;e.addEventListener("input",()=>{values();save(false)});e.addEventListener("change",()=>save(false))});document.querySelectorAll(".purge-action").forEach(button=>button.addEventListener("click",()=>openPurge(button.dataset.target)));byId("hostLogoFile").onchange=function(){image(this,"hostLogoData")};byId("scoringLogoFile").onchange=function(){image(this,"scoringLogoData")};byId("sponsorFile").onchange=function(){image(this,"sponsorData")};byId("confirmText").oninput=function(){byId("confirmButton").disabled=this.value.trim().toUpperCase()!=="CLEAR"};window.addEventListener("resize",sizePreview);sizePreview();');
  Output.Writeln('</script></body></html>');
end.
%>
