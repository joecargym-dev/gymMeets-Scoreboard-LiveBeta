<%
begin
  Output.Writeln('<!DOCTYPE html><html><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1"><title>GymMeets Companion Bars Control v1.0</title>');
  Output.Writeln('<style>');
  Output.Writeln('*{box-sizing:border-box}');
  Output.Writeln(':root{color-scheme:dark}');
  Output.Writeln('body{margin:0;background:#17191d;color:#f4f4f4;font-family:Arial,Helvetica,sans-serif}');
  Output.Writeln('header{position:sticky;top:0;z-index:50;padding:16px 22px;background:rgba(14,16,19,.96);backdrop-filter:blur(8px);border-bottom:1px solid #343840;display:flex;justify-content:space-between;align-items:center}');
  Output.Writeln('header h1{margin:0;font-size:23px}.status{font-size:13px;color:#7ee787}');
  Output.Writeln('.layout{display:grid;grid-template-columns:minmax(370px,540px) 1fr;gap:18px;padding:18px}');
  Output.Writeln('.panel{background:#22262c;border:1px solid #3a4048;border-radius:11px;padding:16px;margin-bottom:16px;box-shadow:0 8px 24px rgba(0,0,0,.14)}');
  Output.Writeln('.panel h2{margin:0 0 14px;font-size:18px}.panel h3{margin:17px 0 8px;padding-top:13px;border-top:1px solid #3a4048;font-size:13px;color:#8cbfff;text-transform:uppercase;letter-spacing:.08em}');
  Output.Writeln('.row{display:grid;grid-template-columns:1fr 170px;gap:12px;align-items:center;margin:10px 0}.row.wide{grid-template-columns:1fr}');
  Output.Writeln('label{font-size:14px;color:#d8d8d8}');
  Output.Writeln('input[type=number],input[type=text],select{width:100%;padding:9px;border-radius:6px;border:1px solid #565d67;background:#111419;color:#fff}');
  Output.Writeln('input[type=color]{width:100%;height:38px;padding:2px;border-radius:6px;border:1px solid #565d67;background:#111419}');
  Output.Writeln('input[type=range]{width:100%}input[type=file]{width:100%;font-size:13px}');
  Output.Writeln('.switch{position:relative;display:inline-block;width:48px;height:26px;flex:0 0 auto;vertical-align:middle}.switch input{position:absolute;opacity:0;width:0;height:0}.slider{display:block;position:absolute;left:0;top:0;width:48px;height:26px;background:#555;border-radius:20px;cursor:pointer}.slider:before{content:"";position:absolute;width:20px;height:20px;left:3px;top:3px;background:#fff;border-radius:50%;transition:transform .2s}.switch input:checked+.slider{background:#2f81f7}.switch input:checked+.slider:before{transform:translateX(22px)}');
  Output.Writeln('.switch-row{display:flex;justify-content:space-between;align-items:center;margin:10px 0}.switch-row>label:first-child{flex:1;padding-right:12px}.switch-row>.switch{flex:0 0 auto}');
  Output.Writeln('.buttons{display:flex;flex-wrap:wrap;gap:9px;margin-top:14px}button{padding:9px 13px;border-radius:6px;border:1px solid #5c6470;background:#303640;color:#fff;cursor:pointer}button:hover{filter:brightness(1.1)}button.primary{background:#2f81f7;border-color:#2f81f7}button.danger{background:#a61f2b;border-color:#dc4653;font-weight:700}button.danger:disabled{opacity:.4;cursor:not-allowed}');
  Output.Writeln('.preview-wrap{position:sticky;top:78px;align-self:start}.preview-title{display:flex;justify-content:space-between;align-items:center;margin-bottom:10px}.preview{position:relative;width:100%;aspect-ratio:16/9;border:1px solid #3a4048;border-radius:10px;overflow:hidden;background:#000}.preview iframe{position:absolute;left:0;top:0;width:1920px;height:1080px;border:0;transform-origin:top left}');
  Output.Writeln('.note{font-size:12px;color:#aab1bb;line-height:1.5}.value{color:#8cbfff;font-weight:bold;margin-left:8px}.logo-preview{max-width:150px;max-height:76px;object-fit:contain;background:#111;border:1px solid #444;padding:4px;display:none}');
  Output.Writeln('.detected-meet{margin:10px 0 14px;padding:11px 12px;border:1px solid #3f566f;border-radius:7px;background:#151d27;color:#dcecff;font-size:13px}.detected-meet strong{color:#8cbfff}.source-options{display:grid;gap:8px;margin:9px 0 12px}.source-option{display:flex;align-items:center;gap:9px;padding:9px 10px;border:1px solid #444b55;border-radius:7px;background:#181b20}.source-option input{margin:0}');
  Output.Writeln('.editing-banner{display:flex;justify-content:space-between;align-items:center;gap:14px;margin-bottom:16px;padding:12px 14px;border:1px solid #3f566f;border-radius:9px;background:#151d27}.editing-banner strong{color:#8cbfff;font-size:16px}.event-code{font-size:12px;color:#aab1bb;text-transform:uppercase;letter-spacing:.1em}');
  Output.Writeln('.danger-panel{border-color:#71313a;background:#2b2024}.danger-panel h2{color:#ff9199}');
  Output.Writeln('.modal-backdrop{position:fixed;inset:0;background:rgba(0,0,0,.78);display:none;align-items:center;justify-content:center;padding:20px;z-index:9999}.modal-backdrop.show{display:flex}.modal{width:min(560px,100%);background:#20242a;border:1px solid #e04b57;border-radius:12px;padding:20px;box-shadow:0 24px 70px rgba(0,0,0,.65)}.modal h2{margin:0 0 10px;color:#ff9199}.modal p{line-height:1.5;color:#d9dde3}.modal-actions{display:flex;justify-content:flex-end;gap:10px;margin-top:16px}.confirm-input{width:100%;padding:10px;border-radius:6px;border:1px solid #6c737d;background:#111419;color:#fff;font-weight:700;text-transform:uppercase}');
  Output.Writeln('@media(max-width:1000px){.layout{grid-template-columns:1fr}.preview-wrap{position:static}}');
  Output.Writeln('</style></head><body>');
  Output.Writeln('<header><h1>GymMeets Companion <span style="color:#8cbfff">Bars Control</span> <span style="font-size:13px;color:#aab1bb">v1.0</span></h1><div class="status" id="saveStatus">Settings ready</div></header>');
  Output.Writeln('<div class="layout"><main><div class="editing-banner"><div><span class="event-code">Editing board</span><br><strong id="editingBoardName">Bars</strong></div><button type="button" class="primary" onclick="openScoreboard()">Open Bars Display</button></div>');
  Output.Writeln('<section class="panel"><h2>Meet Display Title</h2><div id="detectedMeet" class="detected-meet"><strong>Detected ProScore meet:</strong> Waiting for a score...</div><label>Display title source</label><div class="source-options"><label class="source-option"><input type="radio" name="titleSourceChoice" id="titleSourceProscore" value="proscore"> Use ProScore meet title</label><label class="source-option"><input type="radio" name="titleSourceChoice" id="titleSourceCustom" value="custom"> Use custom display title</label></div><div class="row wide"><label>Custom display title</label><input id="customMeetName" type="text" placeholder="Example: 2027 KPAC Cup"></div><div class="row"><label>Header layout</label><select id="headerMode"><option value="full">Full: logos and title</option><option value="title">Title only</option><option value="hidden">Hidden</option></select></div><div class="row"><label>Title color</label><input id="meetTitleColor" type="color"></div><div class="row"><label>Title font</label><select id="meetTitleFont"></select></div><div class="row wide"><label>Title size <span class="value" id="meetTitleSizeValue"></span></label><input id="meetTitleSize" type="range" min="60" max="140" step="5"></div><p class="note">Full shows both logos and the title. Title only removes the logos and uses a shorter header. Hidden gives the score display the full height.</p></section>');
  Output.Writeln('<section class="panel"><h2>Display Controls</h2><div class="row"><label for="displaySeconds">Minimum display time (seconds)</label><input id="displaySeconds" type="number" min="1" max="300" step="1"></div><p class="note">A newly received score waits until the current athlete has been displayed for at least this many seconds. Show Next Now releases the waiting score immediately.</p><div class="buttons"><button class="primary" onclick="saveSettings(true)">Save Settings</button><button onclick="sendCommand(&quot;next&quot;)">Show Next Now</button><button onclick="sendCommand(&quot;replay&quot;)">Replay Current Effect</button></div></section>');
  Output.Writeln('<section class="panel"><h2>Appearance</h2><h3 style="margin-top:0;padding-top:0;border-top:0">Colors</h3><div class="row"><label>Background color</label><input id="backgroundColor" type="color"></div><div class="row"><label>Score color</label><input id="scoreColor" type="color"></div><div class="row"><label>Athlete name color</label><input id="nameColor" type="color"></div><div class="row"><label>Information color</label><input id="detailsColor" type="color"></div><p class="note">Information settings control the gym name and other general supporting text. Metadata pills and the event score ribbon have their own compact styling sections below.</p><h3>Fonts</h3><div class="row"><label>Score font</label><select id="scoreFont"></select></div><div class="row"><label>Athlete name font</label><select id="nameFont"></select></div><div class="row"><label>Information font</label><select id="detailsFont"></select></div><h3>Sizes</h3><div class="row wide"><label>Score size <span class="value" id="scoreSizeValue"></span></label><input id="scoreSize" type="range" min="60" max="140" step="5"></div><div class="row wide"><label>Athlete name maximum size <span class="value" id="nameSizeValue"></span></label><input id="nameSize" type="range" min="60" max="140" step="5"></div><div class="row wide"><label>Event icon size <span class="value" id="iconSizeValue"></span></label><input id="iconSize" type="range" min="60" max="140" step="5"></div><p class="note">The athlete name automatically shrinks when needed. In the basic display, the optional split layout places the first name above the last name to use more of the available screen.</p></section>');
  Output.Writeln('<section class="panel"><h2>Information Display</h2><h3 style="margin-top:0;padding-top:0;border-top:0">Athlete Information</h3><div class="switch-row"><label>Show level</label><label class="switch"><input id="showLevel" type="checkbox"><span class="slider"></span></label></div><div class="switch-row"><label>Show division</label><label class="switch"><input id="showDivision" type="checkbox"><span class="slider"></span></label></div><div class="switch-row"><label>Show competitor number</label><label class="switch"><input id="showNumber" type="checkbox"><span class="slider"></span></label></div><div class="switch-row"><label>Split first and last name in basic display</label><label class="switch"><input id="splitBasicName" type="checkbox"><span class="slider"></span></label></div><h3>Score Ribbon</h3><div class="switch-row"><label>Show event score ribbon</label><label class="switch"><input id="showEventScores" type="checkbox"><span class="slider"></span></label></div><div class="switch-row"><label>Show All-Around score</label><label class="switch"><input id="showAA" type="checkbox"><span class="slider"></span></label></div><p class="note">The event-score option controls VT, UB, BB and FX together. The AA card can be displayed independently. Rank is intentionally excluded for now.</p></section>');
  Output.Writeln('<section class="panel"><h2>Metadata & Event Ribbon</h2><h3 style="margin-top:0;padding-top:0;border-top:0">Metadata Pills</h3><div class="row"><label>Pill font</label><select id="metadataFont"></select></div><div class="row"><label>Pill text color</label><input id="metadataTextColor" type="color"></div><div class="row"><label>Pill base color</label><input id="metadataBaseColor" type="color"></div><p class="note">One base color automatically creates the subtle highlight, darker lower edge, border, and shadow for Level, Division, and competitor number.</p><h3>Event Score Ribbon</h3><div class="row"><label>Ribbon font</label><select id="eventRibbonFont"></select></div><div class="row"><label>Ribbon text color</label><input id="eventRibbonTextColor" type="color"></div><div class="row"><label>Ribbon base color</label><input id="eventRibbonBaseColor" type="color"></div><p class="note">The same font, text color, and generated surface are applied to VT, UB, BB, FX, and AA cards.</p></section>');
  Output.Writeln('<section class="panel"><h2>Score Effects</h2><div class="switch-row"><label>Enable high-score effect</label><label class="switch"><input id="enableHighScoreEffects" type="checkbox"><span class="slider"></span></label></div><div class="row"><label for="highScoreMinimum">Minimum score to trigger</label><input id="highScoreMinimum" type="number" min="0" max="10" step="0.05"></div><div class="switch-row"><label>Enable Perfect 10 celebration</label><label class="switch"><input id="enablePerfectTen" type="checkbox"><span class="slider"></span></label></div><p class="note">High scores at or above the minimum receive the short effect. A 10.00 uses the full Perfect 10 cinematic when enabled.</p></section>');
  Output.Writeln('<section class="panel"><h2>Branding & Sponsors</h2><div class="switch-row"><label>Show left header logo</label><label class="switch"><input id="showHostLogo" type="checkbox"><span class="slider"></span></label></div><div class="row wide"><label>Left header logo</label><input id="hostLogoFile" type="file" accept="image/png,image/jpeg,image/webp,image/bmp"><p class="note"><strong>Optimum file:</strong> 1200 × 400 pixels (3:1). Images are automatically resized and compressed for reliable browser storage.</p></div><img id="hostLogoPreview" class="logo-preview"><h3>Header Right</h3><div class="switch-row"><label>Show right header logo</label><label class="switch"><input id="showScoringLogo" type="checkbox"><span class="slider"></span></label></div><div class="row wide"><label>Right Header logo</label><input id="scoringLogoFile" type="file" accept="image/png,image/jpeg,image/webp,image/bmp"><p class="note"><strong>Optimum file:</strong> 1200 × 400 pixels (3:1). Images are automatically resized and compressed for reliable browser storage.</p></div><img id="scoringLogoPreview" class="logo-preview"></section>');
  Output.Writeln('<section class="panel"><h2>Sponsor Banner</h2><div class="switch-row"><label>Show sponsor banner</label><label class="switch"><input id="showSponsor" type="checkbox"><span class="slider"></span></label></div><div class="row wide"><label>Sponsor image or images</label><input id="sponsorFile" type="file" multiple accept="image/png,image/jpeg,image/webp,image/bmp"><p class="note"><strong>Optimum full-width banner:</strong> 1920 × 160 pixels (12:1 aspect ratio). Images are resized and compressed automatically before storage. Keep important text at least 35 pixels from each edge.</p></div><div id="sponsorCount" class="note">No sponsor images selected.</div><div class="buttons"><button id="removeSponsorButton" type="button" class="danger" onclick="removeSponsorBanners()">Restore Default Sponsor Banner</button></div><div class="row"><label>Banner mode</label><select id="sponsorMode"><option value="static">Static full-width banner</option><option value="scroll">Fade between banners</option></select></div><div class="row wide"><label>Seconds per banner <span class="value" id="sponsorScrollSecondsValue"></span></label><input id="sponsorScrollSeconds" type="range" min="8" max="60" step="1"></div></section>');
  Output.Writeln('<section class="panel danger-panel"><h2>Advanced / Maintenance</h2><p class="note">This action affects the Bars display queue inside GymMeets Companion only. It does not modify or delete scores stored in ProScore.</p><div class="buttons"><button class="danger" onclick="openPurgeModal()">Clear Bars Display Queue</button></div><p class="note">Use this to remove Bars scores waiting to be displayed and reset the Bars scoreboard to its waiting state.</p></section>');
    Output.Writeln('</main><aside class="preview-wrap"><div class="preview-title"><h2 style="margin:0">Live Preview: <span id="previewEventName">Bars</span></h2><div><span class="note">Changes update immediately</span> <button type="button" onclick="resetViewDefaults()">Reset View to Default</button> <button type="button" onclick="refreshPreview()">Refresh Preview</button></div></div><div class="preview"><iframe id="previewFrame" src="barsboard_v1.nxscript?preview=1"></iframe></div><p class="note">Use the same browser profile for the Control Panel and scoreboard.</p></aside></div>');
  Output.Writeln('<div class="modal-backdrop" id="purgeModal" role="dialog" aria-modal="true" aria-labelledby="purgeTitle"><div class="modal"><h2 id="purgeTitle">Clear the Bars display queue?</h2><p>This will remove all Bars scores currently waiting to be displayed in GymMeets Companion and return the Bars scoreboard to its waiting state.</p><p><strong>No scores or meet data inside ProScore will be modified or deleted.</strong></p><p>Type <strong>CLEAR</strong> to confirm.</p><input id="purgeConfirmText" class="confirm-input" type="text" autocomplete="off" placeholder="Type CLEAR"><div class="modal-actions"><button onclick="closePurgeModal()">Cancel</button><button id="confirmPurgeButton" class="danger" disabled onclick="confirmPurge()">Clear Bars Display Queue</button></div></div></div>');
  Output.Writeln('<script>');
  Output.Writeln('const EVENT_CONFIG={bars:{name:"Bars",shortName:"UB",settingsKey:"gymmeetsBarsSettingsV1",commandKey:"gymmeetsBarsCommandV1",board:"barsboard_v1.nxscript"}};');
  Output.Writeln('const currentEvent="bars";');
  Output.Writeln('const SHARED_BRANDING_KEY="gymmeetsSharedBrandingV1";');
  Output.Writeln('const BRANDING_FIELDS=["hostLogoData","scoringLogoData","sponsorData","sponsorItems"];');
Output.Writeln('const sharedBrandingDefaults={hostLogoData:"images/gymmeets-companion-logo.png",scoringLogoData:"images/scoring-logo.png",sponsorData:"images/sponsor-banner.png",sponsorItems:["images/sponsor-banner.png"]};');
  Output.Writeln('function eventConfig(eventName){return EVENT_CONFIG[eventName]||EVENT_CONFIG.bars;}');
  Output.Writeln('function settingsKey(eventName){return eventConfig(eventName||currentEvent).settingsKey;}');
  Output.Writeln('function commandKey(eventName){return eventConfig(eventName||currentEvent).commandKey;}');
  Output.Writeln('function cloneSettings(settings){return JSON.parse(JSON.stringify(settings||{}));}');
  Output.Writeln('function loadSharedBranding(){var result;try{result=Object.assign({},sharedBrandingDefaults,JSON.parse(localStorage.getItem(SHARED_BRANDING_KEY)||"{}"));}catch(error){result=Object.assign({},sharedBrandingDefaults);}if(result.hostLogoData==="images/host-logo.png")result.hostLogoData=sharedBrandingDefaults.hostLogoData;return result;}');
  Output.Writeln('function saveSharedBranding(branding){localStorage.setItem(SHARED_BRANDING_KEY,JSON.stringify(Object.assign({},sharedBrandingDefaults,branding||{})));return true;}');
  Output.Writeln('function stripBranding(settings){var clean=cloneSettings(settings);BRANDING_FIELDS.forEach(function(key){delete clean[key];});return clean;}');
  Output.Writeln('function saveEventSettings(eventName,settings){localStorage.setItem(settingsKey(eventName),JSON.stringify(stripBranding(settings)));return true;}');
  Output.Writeln('function dataSizeKB(value){try{return Math.round((JSON.stringify(value).length*2)/1024);}catch(error){return 0;}}');
  Output.Writeln('function migrateSharedBranding(){if(localStorage.getItem(SHARED_BRANDING_KEY))return;var selected=null;Object.keys(EVENT_CONFIG).some(function(eventName){try{var raw=JSON.parse(localStorage.getItem(settingsKey(eventName))||"{}");var items=Array.isArray(raw.sponsorItems)?raw.sponsorItems:[];if(raw.hostLogoData||raw.scoringLogoData||raw.sponsorData||items.length){selected={hostLogoData:raw.hostLogoData||"",scoringLogoData:raw.scoringLogoData||"",sponsorItems:items.length?items.slice():(raw.sponsorData?[raw.sponsorData]:[])};selected.sponsorData=selected.sponsorItems[0]||raw.sponsorData||"";return true;}}catch(error){}return false;});if(!selected)return;Object.keys(EVENT_CONFIG).forEach(function(eventName){try{var raw=JSON.parse(localStorage.getItem(settingsKey(eventName))||"{}");localStorage.setItem(settingsKey(eventName),JSON.stringify(stripBranding(raw)));}catch(error){}});try{saveSharedBranding(selected);}catch(error){setStatus("Shared branding migration could not finish because browser storage is full.",4500);}}');
  Output.Writeln('function canvasData(image,maxWidth,maxHeight,quality){var scale=Math.min(1,maxWidth/image.naturalWidth,maxHeight/image.naturalHeight),width=Math.max(1,Math.round(image.naturalWidth*scale)),height=Math.max(1,Math.round(image.naturalHeight*scale)),canvas=document.createElement("canvas"),context=canvas.getContext("2d");canvas.width=width;canvas.height=height;context.clearRect(0,0,width,height);context.drawImage(image,0,0,width,height);var data="";try{data=canvas.toDataURL("image/webp",quality);if(!data||data.indexOf("data:image/webp")!==0)data=canvas.toDataURL("image/jpeg",Math.min(.88,quality));}catch(error){data="";}return data;}');
  Output.Writeln('function processImageFile(file,maxWidth,maxHeight,quality,done,failed){if(!file||!/^image\//i.test(file.type)){failed("Please choose an image file.");return;}var reader=new FileReader();reader.onerror=function(){failed("Could not read "+file.name+".");};reader.onload=function(){var image=new Image();image.onerror=function(){failed("Could not load "+file.name+".");};image.onload=function(){var data=canvasData(image,maxWidth,maxHeight,quality);if(!data){failed("Could not process "+file.name+".");return;}done(data);};image.src=reader.result;};reader.readAsDataURL(file);}');
  Output.Writeln('const DETECTED_MEET_KEY="gymmeetsDetectedMeetV4";');
  Output.Writeln('const fonts=["Arial","Arial Black","Verdana","Tahoma","Trebuchet MS","Impact","Georgia","Times New Roman","Courier New"];');
  Output.Writeln('const defaults={displaySeconds:30,backgroundColor:"#070b10",scoreColor:"#ff2b2b",nameColor:"#f5f8ff",detailsColor:"#00e5e5",scoreFont:"Arial Black",nameFont:"Arial Black",detailsFont:"Arial",metadataFont:"Arial",metadataTextColor:"#ffff00",metadataBaseColor:"#000000",eventRibbonFont:"Arial",eventRibbonTextColor:"#00e5e5",eventRibbonBaseColor:"#151f2d",enableHighScoreEffects:true,highScoreMinimum:9.7,enablePerfectTen:true,scoreSize:140,nameSize:140,iconSize:140,meetTitleColor:"#ffffff",meetTitleFont:"Arial Black",meetTitleSize:100,showNumber:true,showLevel:true,showDivision:true,showEventScores:true,showAA:true,showHostLogo:true,hostLogoData:"",showScoringLogo:true,scoringLogoData:"",showSponsor:true,sponsorData:"",sponsorItems:[],sponsorMode:"static",sponsorScrollSeconds:24,titleSource:"proscore",headerMode:"full",splitBasicName:true,useCustomMeetName:false,customMeetName:""};');
  Output.Writeln('const byId=function(id){return document.getElementById(id);};');
Output.Writeln('function initializeFirstRun(){if(localStorage.getItem(settingsKey(currentEvent)))return;var firstRunSettings=Object.assign({},defaults);try{saveEventSettings(currentEvent,firstRunSettings);localStorage.setItem(currentEvent+"DisplaySeconds",String(firstRunSettings.displaySeconds));}catch(error){setStatus("Could not initialize default view.",3200);}}');
  Output.Writeln('function sizePreview(){var frame=byId("previewFrame");if(!frame)return;var wrap=frame.parentElement;if(!wrap)return;var scale=wrap.clientWidth/1920;frame.style.width="1920px";frame.style.height="1080px";frame.style.transform="scale("+scale+")";}');
  Output.Writeln('function populateFonts(){["scoreFont","nameFont","detailsFont","metadataFont","eventRibbonFont","meetTitleFont"].forEach(function(id){var select=byId(id);fonts.forEach(function(font){var option=document.createElement("option");option.value=font;option.textContent=font;option.style.fontFamily=font;select.appendChild(option);});});}');
  Output.Writeln('function getSettings(eventName){var eventSettings={};try{eventSettings=JSON.parse(localStorage.getItem(settingsKey(eventName))||"{}");}catch(error){}return Object.assign({},defaults,eventSettings,loadSharedBranding());}');
  Output.Writeln('function setForm(settings){if(!settings.titleSource)settings.titleSource=settings.useCustomMeetName?"custom":"proscore";if(!settings.headerMode)settings.headerMode="full";Object.keys(defaults).forEach(function(key){var element=byId(key);if(!element||key.slice(-4)==="Data"||key==="titleSource")return;if(element.type==="checkbox")element.checked=!!settings[key];else element.value=settings[key];});byId("titleSourceProscore").checked=settings.titleSource!=="custom";byId("titleSourceCustom").checked=settings.titleSource==="custom";updateValues();showImagePreview("hostLogoPreview",settings.hostLogoData);showImagePreview("scoringLogoPreview",settings.scoringLogoData);var count=Array.isArray(settings.sponsorItems)?settings.sponsorItems.length:(settings.sponsorData?1:0);byId("sponsorCount").textContent=count?(count+" sponsor image"+(count===1?"":"s")+" loaded"):"No sponsor images selected.";var defaultSponsorOnly=count===1&&Array.isArray(settings.sponsorItems)&&settings.sponsorItems[0]==="images/sponsor-banner.png";byId("removeSponsorButton").disabled=defaultSponsorOnly;}');
  Output.Writeln('function readForm(){var settings=getSettings();["displaySeconds","scoreSize","nameSize","iconSize","meetTitleSize","sponsorScrollSeconds","highScoreMinimum"].forEach(function(key){settings[key]=key==="highScoreMinimum"?parseFloat(byId(key).value):parseInt(byId(key).value,10);});["backgroundColor","scoreColor","nameColor","detailsColor","scoreFont","nameFont","detailsFont","metadataFont","metadataTextColor","metadataBaseColor","eventRibbonFont","eventRibbonTextColor","eventRibbonBaseColor","meetTitleColor","meetTitleFont","sponsorMode","customMeetName","headerMode"].forEach(function(key){settings[key]=byId(key).value;});["showNumber","splitBasicName","showLevel","showDivision","showEventScores","showAA","enableHighScoreEffects","enablePerfectTen","showHostLogo","showScoringLogo","showSponsor"].forEach(function(key){settings[key]=byId(key).checked;});settings.titleSource=byId("titleSourceCustom").checked?"custom":"proscore";settings.useCustomMeetName=settings.titleSource==="custom";return settings;}');
  Output.Writeln('function saveSettings(showMessage){var settings=readForm();try{saveEventSettings(currentEvent,settings);localStorage.setItem(currentEvent+"DisplaySeconds",String(settings.displaySeconds));if(showMessage){setStatus(eventConfig(currentEvent).name+" settings saved",1500);refreshPreview();}return true;}catch(error){setStatus("Could not save settings because browser storage is full.",3800);return false;}}');
  Output.Writeln('function resetViewDefaults(){var settings=getSettings(currentEvent);settings.scoreSize=defaults.scoreSize;settings.nameSize=defaults.nameSize;settings.iconSize=defaults.iconSize;settings.meetTitleSize=defaults.meetTitleSize;try{saveEventSettings(currentEvent,settings);setForm(getSettings(currentEvent));setStatus("View sizes reset to defaults.",1800);refreshPreview();}catch(error){setStatus("Could not reset the view.",3200);}}');
  Output.Writeln('function setStatus(message,duration){byId("saveStatus").textContent=message;if(duration){window.setTimeout(function(){byId("saveStatus").textContent="Settings ready";},duration);}}');
  Output.Writeln('function updateValues(){["scoreSize","nameSize","iconSize","meetTitleSize"].forEach(function(key){byId(key+"Value").textContent=byId(key).value+"%";});byId("sponsorScrollSecondsValue").textContent=byId("sponsorScrollSeconds").value+" sec";}');
  Output.Writeln('function updateDetectedMeet(){var box=byId("detectedMeet");if(!box)return;try{var detected=JSON.parse(localStorage.getItem(DETECTED_MEET_KEY)||"{}");if(detected.meetName){box.innerHTML="<strong>Detected ProScore meet:</strong> "+detected.meetName+(detected.meetID?" <span class=\"note\">(MeetID "+detected.meetID+")</span>":"");}else{box.innerHTML="<strong>Detected ProScore meet:</strong> Waiting for a score...";}}catch(error){box.innerHTML="<strong>Detected ProScore meet:</strong> Waiting for a score...";}}');
  Output.Writeln('function showImagePreview(id,data){var image=byId(id);if(data){image.src=data;image.style.display="block";}else{image.removeAttribute("src");image.style.display="none";}}');
  Output.Writeln('function bindImage(inputId,key,previewId){byId(inputId).addEventListener("change",function(){var input=this,file=input.files&&input.files[0];if(!file)return;setStatus("Processing "+file.name+"...",0);processImageFile(file,700,420,.78,function(data){var branding=loadSharedBranding();branding[key]=data;try{saveSharedBranding(branding);showImagePreview(previewId,data);input.value="";setStatus((key==="hostLogoData"?"Left header logo":"Right header logo")+" updated",2300);refreshPreview();}catch(error){setStatus("Browser storage is full. Remove unused sponsor images or use a smaller source image.",4200);}},function(message){input.value="";setStatus(message,3200);});});}');
  Output.Writeln('function bindSponsorImages(){byId("sponsorFile").addEventListener("change",function(){var input=this,files=Array.from(input.files||[]);if(!files.length)return;setStatus("Processing "+files.length+" sponsor image"+(files.length===1?"":"s")+"...",0);var completed=0,failedCount=0,newItems=new Array(files.length);files.forEach(function(file,index){processImageFile(file,1920,240,.72,function(data){newItems[index]=data;completed++;finish();},function(){failedCount++;completed++;finish();});});function finish(){if(completed!==files.length)return;var branding=loadSharedBranding(),existing=Array.isArray(branding.sponsorItems)?branding.sponsorItems.slice():(branding.sponsorData?[branding.sponsorData]:[]);branding.sponsorItems=existing.concat(newItems.filter(Boolean));branding.sponsorData=branding.sponsorItems[0]||"";try{saveSharedBranding(branding);input.value="";setForm(getSettings(currentEvent));setStatus(branding.sponsorItems.length+" sponsor image"+(branding.sponsorItems.length===1?"":"s")+" saved"+(failedCount?" ("+failedCount+" skipped)":"."),3200);refreshPreview();}catch(error){input.value="";setStatus("Browser storage is full. Upload fewer sponsor images or remove existing ones.",4500);}}});}');
  Output.Writeln('function removeSponsorBanners(){var branding=loadSharedBranding();branding.sponsorData="images/sponsor-banner.png";branding.sponsorItems=["images/sponsor-banner.png"];try{saveSharedBranding(branding);setForm(getSettings(currentEvent));setStatus("Default sponsor banner restored.",2300);refreshPreview();}catch(error){setStatus("Could not restore the default sponsor banner.",3200);}}');
  Output.Writeln('function sendCommand(command){localStorage.setItem(commandKey(),JSON.stringify({command:command,at:Date.now()}));setStatus(eventConfig(currentEvent).name+" command sent: "+command,1300);}');
  Output.Writeln('function openScoreboard(){var config=eventConfig(currentEvent);var w=window.open(config.board,"GymMeets"+config.shortName+"Board","popup,resizable=yes,width=1600,height=900");if(w){w.focus();}}');
  Output.Writeln('function refreshPreview(){var frame=byId("previewFrame"),config=eventConfig(currentEvent);frame.onload=sizePreview;frame.src=config.board+"?preview=1&t="+Date.now();requestAnimationFrame(sizePreview);setStatus(config.name+" preview refreshed",1200);}');
  Output.Writeln('function openPurgeModal(){var modal=byId("purgeModal");var input=byId("purgeConfirmText");var button=byId("confirmPurgeButton");input.value="";button.disabled=true;modal.classList.add("show");window.setTimeout(function(){input.focus();},40);}');
  Output.Writeln('function closePurgeModal(){byId("purgeModal").classList.remove("show");}');
  Output.Writeln('function confirmPurge(){var input=byId("purgeConfirmText");if(input.value.trim().toUpperCase()!=="CLEAR")return;sendCommand("purgeAllScores");localStorage.removeItem("gymmeetsCurrentScore");localStorage.removeItem("gymmeetsScoreHistory");localStorage.removeItem("gymmeets"+eventConfig(currentEvent).shortName+"CurrentScore");localStorage.removeItem("gymmeets"+eventConfig(currentEvent).shortName+"ScoreHistory");closePurgeModal();setStatus("Vault display queue cleared. ProScore data was not affected.",3200);}');
  Output.Writeln('function bindControls(){document.querySelectorAll("input,select").forEach(function(element){if(element.type==="file"||element.id==="purgeConfirmText")return;element.addEventListener("input",function(){updateValues();saveSettings(false);});element.addEventListener("change",function(){updateValues();saveSettings(false);});});byId("purgeConfirmText").addEventListener("input",function(){byId("confirmPurgeButton").disabled=this.value.trim().toUpperCase()!=="CLEAR";});byId("purgeModal").addEventListener("click",function(event){if(event.target===this)closePurgeModal();});document.addEventListener("keydown",function(event){if(event.key==="Escape")closePurgeModal();});}');
  Output.Writeln('window.addEventListener("resize",sizePreview);');
  Output.Writeln('migrateSharedBranding();');
Output.Writeln('initializeFirstRun();');
Output.Writeln('populateFonts();');
Output.Writeln('setForm(getSettings());');
  Output.Writeln('sizePreview();');
  Output.Writeln('refreshPreview();');
  Output.Writeln('updateDetectedMeet();setInterval(updateDetectedMeet,1000);');
  Output.Writeln('bindImage("hostLogoFile","hostLogoData","hostLogoPreview");');
  Output.Writeln('bindImage("scoringLogoFile","scoringLogoData","scoringLogoPreview");');
  Output.Writeln('bindSponsorImages();');
  Output.Writeln('bindControls();');
  Output.Writeln('</script></body></html>');
end.
%>
